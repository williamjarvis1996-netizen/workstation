---
import { ClientRouter } from 'astro:transitions';
import '../styles/dashboard.css';
interface Props {
  title?: string;
  active?: string;
}

const { title = 'Workstation', active = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = [
  ['overview', '', 'Overview'],
  ['work', 'work/', 'Work'],
  ['tasks', 'tasks/', 'Tasks'],
  ['training', 'training/', 'Training'],
  ['creative', 'creative/', 'Creative'],
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-area={active}>
    <div class="noise"></div>
    <header class="site-header">
      <div class="container header-inner">
        <a href={base} class="logo">
          <span class="logo-mark">//</span> workstation
        </a>
        <nav aria-label="Main navigation">
          {navigation.map(([key, path, label]) => (
            <a href={base + path} data-nav={key} aria-current={active === key ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container" transition:name="workstation-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="footer-text">WJ workstation</span>
        <span class="footer-text" id="footer-time"></span>
      </div>
    </footer>
    <div class="capture-dock">
      <span class="capture-feedback" id="capture-feedback" role="status"></span>
      <button type="button" id="capture-open" aria-haspopup="dialog" title="Ctrl or Command + Shift + K">+ Capture</button>
    </div>
    <dialog class="capture-dialog" id="capture-dialog" aria-labelledby="capture-title">
      <form>
        <h2 id="capture-title">Quick capture</h2>
        <label>Save to <select name="kind"><option value="task">Tasks</option><option value="workout">Training</option><option value="idea">Creative ideas</option></select></label>
        <label>Title <input name="title" maxlength="140" required /></label>
        <fieldset data-kind="task">
          <label>Due <input type="date" name="due" /></label>
          <label>Priority <select name="priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></label>
          <label>Project <input name="project" maxlength="100" /></label>
        </fieldset>
        <fieldset data-kind="workout" hidden disabled>
          <label>Date <input type="date" name="workoutDate" required /></label>
          <label>Activity <select name="workoutType"><option value="run">Run</option><option value="gym">Gym</option><option value="cycle">Cycle</option><option value="swim">Swim</option><option value="row">Row</option></select></label>
          <label>Distance (km) <input type="number" name="distance" min="0" step=".01" /></label>
          <label>Duration (min) <input type="number" name="duration" min="1" step="1" /></label>
        </fieldset>
        <fieldset data-kind="idea" hidden disabled><label>Notes <textarea name="notes" maxlength="1000"></textarea></label></fieldset>
        <p role="status" class="top-sync"></p>
        <div class="capture-actions"><button type="button" data-close>Cancel</button><button type="submit">Save</button></div>
      </form>
    </dialog>
    <script>
      import '../lib/capture.mjs';
      import { londonClock, londonDay } from '../lib/time.mjs';
      function updateFooterTime() {
        const el = document.getElementById('footer-time');
        if (!el) return;
        const now = new Date();
        el.textContent = londonClock(now.getTime()) + ' London';
      }
      function updateDateLabels() {
        updateFooterTime();
        const race = document.querySelector<HTMLElement>('#weeks-to-race');
        if (!race?.dataset.raceDate) return;
        const days = (Date.parse(race.dataset.raceDate) - Date.parse(londonDay(Date.now()))) / 86400000;
        if (!Number.isFinite(days)) return;
        race.textContent = days > 0 ? `${days} days` : days === 0 ? 'Race day' : 'Race date passed';
      }
      document.addEventListener('astro:page-load', updateDateLabels);
      document.addEventListener('visibilitychange', updateDateLabels);
      setInterval(updateDateLabels, 30000);
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .noise {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px;
    pointer-events: none;
  }

  .site-header {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-sm);
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 100;
  }

  @media (min-width: 1000px) {
    .site-header {
      position: fixed;
      inset: 0 auto 0 0;
      width: 10rem;
      border-bottom: none;
      border-right: 1px solid var(--color-border-hover);
      padding-block: 1rem;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-fg);
    text-decoration: none;
    transition: color 0.15s;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .logo-mark {
    color: var(--color-accent);
  }

  nav {
    display: flex;
    gap: var(--space-lg);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
    text-decoration: none;
    padding: var(--space-xs) 0;
    position: relative;
    transition: color 0.15s;
  }

  nav a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s;
  }

  nav a:hover {
    color: var(--color-fg);
    text-decoration: none;
  }

  nav a:hover::after {
    transform: scaleX(1);
  }

  main {
    padding-block: var(--space-2xl);
    min-height: calc(100vh - 120px);
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-md);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-fg-subtle);
  }
</style>

<style>
  nav { flex-wrap: wrap; justify-content: flex-end; gap: .4rem 1rem; }
  nav a[aria-current="page"] { color: var(--color-accent); }
  @media (max-width: 620px) {
    .header-inner { align-items: flex-start; flex-direction: column; gap: .25rem; }
    nav { justify-content: flex-start; }
  }
</style>

<style is:global>
  @media (min-width: 1000px) {
    body { padding-inline-start: 10rem; }
    .site-header { position: fixed; inset: 0 auto 0 0; width: 10rem; border-right: 1px solid var(--color-border-hover); padding-block: 1rem; background: linear-gradient(180deg, rgba(14, 18, 28, 0.95), rgba(11, 14, 20, 0.98)); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
    .site-header .header-inner { flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 1.4rem; }
    .site-header .logo { display: block; padding: .4rem .25rem; white-space: nowrap; }
    .site-header nav { flex-direction: column; gap: .25rem; }
    .site-header nav a { padding: .35rem .65rem; border-radius: var(--radius); font-size: .65rem; }
    .site-header nav a::after { display: none; }
    .site-header nav a:hover { background: var(--color-surface-hover); }
    .site-header nav a[aria-current="page"] { background: var(--color-accent-dim); }
  }
</style>
