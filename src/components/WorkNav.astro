---
interface Props { active: 'board' | 'timeline' | 'activity' }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL + 'work/';
const items = [
  { key: 'board', label: 'Board', href: base },
  { key: 'timeline', label: 'Timeline', href: base + 'timeline/' },
  { key: 'activity', label: 'Activity', href: base + 'activity/' },
];
---
<nav class="work-nav" aria-label="Work">
  {items.map(item => <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>)}
</nav>
