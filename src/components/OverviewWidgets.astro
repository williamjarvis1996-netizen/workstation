---
import { dashboard } from '../content/dashboard';
const projects = dashboard.creativeProjects.map(project => project.name);
const base = import.meta.env.BASE_URL;
---
<section class="after-hours" aria-labelledby="after-hours-title" data-projects={JSON.stringify(projects)}>
  <h2 id="after-hours-title">After hours</h2>
  <div class="after-hours-grid">
    <section class="widget culture">
      <h3>Culture Shelf</h3>
      <form id="culture-shelf">
        <label>Watching<input name="watching" maxlength="100" placeholder="Add a film or series" /></label>
        <label>Reading<input name="reading" maxlength="100" placeholder="Add a book" /></label>
        <label>Playing<input name="playing" maxlength="100" placeholder="Add a game" /></label>
        <button type="submit">Save shelf</button>
        <p class="widget-status" data-shelf-status role="status"></p>
      </form>
    </section>

    <section class="widget double">
      <h3>Double Feature</h3>
      <div class="double-pair" aria-live="polite">
        <div><small>From your shelf</small><strong data-reference>Add a title to your shelf</strong></div>
        <div><small>From your slate</small><strong data-project></strong></div>
      </div>
      <p>What could the project borrow from this reference?</p>
      <div class="widget-actions">
        <button type="button" data-deal>Deal another pair</button>
        <a href={base + 'creative/'}>Creative slate &rarr;</a>
      </div>
    </section>

    <section class="widget mixtape">
      <h3>Marathon Mixtape</h3>
      <p class="tape-readout"><strong data-runtime>0:00</strong><span> / 4:00:00</span></p>
      <progress data-tape-progress max="14400" value="0" aria-label="Mixtape listening time"></progress>
      <p class="widget-status" data-tape-balance></p>
      <form id="mixtape-queue">
        <div class="tape-fields">
          <label>Track or voice note<input name="title" maxlength="100" required /></label>
          <label>Duration<input name="duration" inputmode="text" placeholder="m:ss" pattern="[0-9]{1,3}:[0-5][0-9]" required /></label>
        </div>
        <button type="submit">Add to tape</button>
      </form>
      <details>
        <summary>Queue <span data-queue-count>(0)</span></summary>
        <ol data-tape-items></ol>
      </details>
      <form id="mixtape-player">
        <label>Spotify playlist link<input name="playlist" type="url" placeholder="https://open.spotify.com/playlist/…" required /></label>
        <button type="submit">Load Spotify player</button>
      </form>
      <div data-player></div>
      <p class="widget-status" data-tape-status role="status"></p>
    </section>
  </div>
  <p class="widget-storage">Shelf and mixtape entries are saved in this browser.</p>
</section>

<script>
  import '../lib/overview-widgets.mjs';
</script>

<style>
  .after-hours { display: grid; gap: var(--space-sm); }
  .after-hours h2 { font: 700 1.2rem/1.2 var(--font-sans); }
  .after-hours-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-sm); align-items: start; }
  .widget { display: grid; gap: .65rem; min-width: 0; padding: var(--panel-inset); border: 1px solid var(--color-border-hover); border-top: 2px solid var(--widget-accent); border-radius: var(--radius-lg); background: linear-gradient(145deg, color-mix(in srgb, var(--widget-accent) 9%, var(--color-bg-raised)), var(--color-bg-raised)); }
  .culture { --widget-accent: #b89efa; }
  .double { --widget-accent: #ff7885; }
  .mixtape { --widget-accent: #4ade80; }
  .widget h3 { color: var(--widget-accent); font: 700 1.05rem/1.25 var(--font-sans); }
  .widget p, .widget a, .widget details { font-size: .83rem; }
  .widget form, .widget label { display: grid; gap: .35rem; min-width: 0; }
  .widget label, .widget small, .widget-status, .widget-storage { color: var(--color-fg-muted); font: .72rem/1.4 var(--font-mono); }
  .widget form { gap: .55rem; }
  .widget input, .widget button { min-width: 0; min-height: 2.4rem; border: 1px solid var(--color-border-hover); border-radius: var(--radius); background: var(--color-bg); color: var(--color-fg); padding: .35rem .55rem; font: .84rem var(--font-sans); }
  .widget button { justify-self: start; cursor: pointer; }
  .widget button:hover:enabled { border-color: var(--widget-accent); }
  .widget button:disabled { opacity: .6; cursor: default; }
  .widget-actions { display: flex; flex-wrap: wrap; gap: .65rem; align-items: center; }
  .double-pair { display: grid; gap: .4rem; }
  .double-pair div { display: grid; gap: .15rem; padding: .5rem .65rem; border-inline-start: 2px solid var(--widget-accent); background: var(--color-surface); overflow-wrap: anywhere; }
  .tape-readout strong { color: var(--widget-accent); font: 700 1.65rem/1 var(--font-mono); }
  .tape-readout span { font-family: var(--font-mono); }
  .widget progress { width: 100%; accent-color: var(--widget-accent); }
  .tape-fields { display: grid; grid-template-columns: minmax(0, 1fr) 4.9rem; gap: .5rem; }
  .widget summary { cursor: pointer; }
  .widget ol { padding-inline-start: 1.25rem; overflow-wrap: anywhere; }
  .widget :global(iframe) { width: 100%; border: 0; border-radius: var(--radius); }
  .widget-status:empty, [data-player]:empty { display: none; }
  @media (max-width: 830px) { .after-hours-grid { grid-template-columns: 1fr; } }
</style>
