---
interface Props { active: 'overview' | 'running' | 'strength' }
const { active } = Astro.props;
const base = import.meta.env.BASE_URL + 'training/';
const items = [
  { key: 'overview', label: 'Overview', href: base },
  { key: 'running', label: 'Running', href: base + 'running/' },
  { key: 'strength', label: 'Strength', href: base + 'strength/' },
];
---
<nav class="training-nav" aria-label="Exercise">
  {items.map(item => <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>{item.label}</a>)}
</nav>
