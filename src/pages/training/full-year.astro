---
import Base from '../../layouts/Base.astro';
import { dashboard } from '../../content/dashboard';
import '../../styles/training-year.css';
const base = import.meta.env.BASE_URL;
const { marathonTraining: marathon, exerciseSessions } = dashboard;
---
<Base title="Training year | Workstation" active="training">
  <div class="dashboard training-year" id="training-year" data-sessions={JSON.stringify(exerciseSessions)}>
    <nav aria-label="Training navigation" class="project-breadcrumb"><a href={base + 'training/'}>Training</a><span aria-hidden="true">/</span><span>Full year</span></nav>
    <header class="area-header"><h1>Training year</h1></header>
    <div class="training-year-grid">
      <section class="panel year-race" aria-labelledby="race-heading">
        <span class="top-sync">Race target · Team Shelter</span>
        <h2 id="race-heading">{marathon?.raceName || 'TCS London Marathon 2027'}</h2>
        {marathon && <strong id="weeks-to-race" data-race-date={marathon.raceDate}>{marathon.weeksToRace} weeks</strong>}
        <p>{marathon?.targetTime || 'Sub-4 hours'} · {marathon?.weeklyStructure || 'Two runs and two gym sessions'}</p>
      </section>
      <section class="panel year-milestones">
        <h2>Marathon build</h2>
        {marathon && <dl>
          <div><dt>Current block</dt><dd>{marathon.currentPhase} · Week {marathon.weekNumber}</dd></div>
          <div><dt>Latest recorded long run</dt><dd>{marathon.lastLongRun.split(' (')[0]} · {marathon.lastLongRunDate}</dd></div>
          <div><dt>Next long-run target</dt><dd>{marathon.nextLongRunTarget}</dd></div>
        </dl>}
        <p class="year-note">Build and taper dates are pending the marathon plan.</p>
      </section>
    </div>
    <section class="panel year-mileage">
      <div class="panel-head">
        <h2>Weekly mileage</h2>
        <label>Year <select id="training-year-filter"><option>2026</option><option>2027</option></select></label>
      </div>
      <div id="year-stats" class="task-stats"></div>
      <div id="year-chart" class="year-chart" aria-hidden="true"></div>
      <div class="year-legend"><span>Recorded mileage</span><span>No run recorded</span><span>Race week</span></div>
      <details class="year-ledger"><summary>Weekly figures</summary>
        <table><thead><tr><th scope="col">Week of</th><th scope="col">Distance</th><th scope="col">Runs</th></tr></thead><tbody id="year-weeks"></tbody></table>
      </details>
    </section>
    <div class="training-year-grid">
      <section class="panel year-milestones">
        <h2>Race archive</h2>
        <dl><div><dt>17 May 2026</dt><dd>Hackney Half Marathon</dd></div>
          <div><dt>Recorded finish</dt><dd id="hackney-finish">Import the race log to display the recorded time</dd></div></dl>
      </section>
      <section class="panel year-milestones">
        <h2>Training log import</h2>
        <p>Import the Running Log or Strength Training Log from Obsidian. Distances stay in their original units in the ledger and are converted to kilometres for the chart.</p>
        <form id="year-import">
          <label>Log year <input name="year" type="number" min="2000" max="2100" value="2026" required /></label>
          <label>Obsidian log <input name="file" type="file" accept=".md,.txt,text/plain,text/markdown" required /></label>
          <button type="submit" class="action-button">Import sessions</button>
        </form>
        <p id="year-import-status" class="top-sync" role="status"></p>
      </section>
    </div>
    <section class="panel year-milestones">
      <h2>Cross-training</h2>
      <p>Track strength sessions and logged swims alongside the running block. The running log import leaves hiking out of mileage and preserves treadmill calibration notes.</p>
      <dl id="year-cross-training"></dl>
    </section>
    <section class="panel year-ledger">
      <h2>Strength ledger</h2>
      <p class="year-note">Machine stacks differ by gym. Recorded volume describes each visit. Compare loads only on comparable equipment.</p>
      <div class="year-table-scroll"><table><thead><tr><th scope="col">Date</th><th scope="col">Split</th><th scope="col">Gym</th><th scope="col">Sets</th><th scope="col">Volume</th></tr></thead><tbody id="year-strength"></tbody></table></div>
    </section>
    <section class="panel year-ledger">
      <h2>Run ledger</h2>
      <div class="year-table-scroll"><table><thead><tr><th scope="col">Date</th><th scope="col">Run</th><th scope="col">Distance</th><th scope="col">Time</th><th scope="col">Pace</th></tr></thead><tbody id="year-runs"></tbody></table></div>
    </section>
  </div>
</Base>
<script>
  import '../../lib/training-year-view.mjs';
</script>
