---
import Base from '../layouts/Base.astro';
import { projects, tasks, log, quickLinks, calendarEvents, lastUpdated } from '../content/dashboard';

const activeTasks = tasks.filter(t => !t.completed);
const recentLog = log.slice(0, 8);
const base = import.meta.env.BASE_URL;

const today = new Date();
const dayName = today.toLocaleDateString('en-GB', { weekday: 'long' });
const dayNum = today.getDate();
const monthName = today.toLocaleDateString('en-GB', { month: 'long' });
const year = today.getFullYear();
const todayStr = today.toISOString().slice(0, 10);

const todayEvents = calendarEvents.filter(e => e.date === todayStr);
const upcomingEvents = calendarEvents.filter(e => e.date > todayStr).slice(0, 3);
const nextEvent = todayEvents[0] || upcomingEvents[0];

const overdueTasks = activeTasks.filter(t => t.due && t.due < todayStr);
const todayTasks = activeTasks.filter(t => t.due === todayStr);
const upcomingTasks = activeTasks.filter(t => !t.due || t.due > todayStr);

function formatEventDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
}

function getNextMeetingLabel(): string {
  if (!nextEvent) return '';
  if (nextEvent.date === todayStr && nextEvent.startTime) {
    return `next meeting at ${nextEvent.startTime}`;
  }
  if (nextEvent.date > todayStr) {
    const d = new Date(nextEvent.date + 'T00:00:00');
    const diff = Math.ceil((d.getTime() - today.getTime()) / 86400000);
    const timeStr = nextEvent.startTime ? ` at ${nextEvent.startTime}` : '';
    return `next meeting in ${diff}d${timeStr}`;
  }
  return '';
}

const statusParts: string[] = [];
if (overdueTasks.length) statusParts.push(`${overdueTasks.length} overdue`);
if (todayTasks.length) statusParts.push(`${todayTasks.length} due today`);
const meetingLabel = getNextMeetingLabel();
if (meetingLabel) statusParts.push(meetingLabel);

const projectHealthMap: Record<string, string> = {};
projects.forEach(p => {
  if (p.status === 'completed') projectHealthMap[p.code] = 'done';
  else if (p.status === 'paused') projectHealthMap[p.code] = 'paused';
  else projectHealthMap[p.code] = 'active';
});
---

<Base title="Workstation">
  <div class="dashboard">

    <!-- ===== STATUS BAR ===== -->
    <section class="status-bar">
      <div class="status-left">
        <span class="status-date">{dayName} {dayNum} {monthName} {year}</span>
        <span class="status-sep">/</span>
        <span class="status-sync">synced {lastUpdated}</span>
      </div>
      <div class="status-right" id="weather-inline"></div>
    </section>

    <!-- ===== ALERT BANNER ===== -->
    {statusParts.length > 0 && (
      <section class={`alert-banner ${overdueTasks.length > 0 ? 'alert-banner--warn' : ''}`}>
        <span class="alert-pulse"></span>
        <span class="alert-text">{statusParts.join(' / ')}</span>
      </section>
    )}

    <!-- ===== TOP ROW: Tasks + Agenda ===== -->
    <div class="grid-top">

      <section class="panel tasks-panel">
        <div class="panel-header">
          <h2 class="panel-title">Tasks</h2>
          <span class="panel-count">{activeTasks.length}</span>
        </div>

        {overdueTasks.length > 0 && (
          <div class="task-group">
            <span class="task-group-label task-group-label--overdue">Overdue</span>
            {overdueTasks.map(task => (
              <div class="task-row task-row--overdue">
                <span class="task-dot task-dot--overdue"></span>
                <span class="task-name">{task.title}</span>
                {task.project && <span class="task-tag">{task.project}</span>}
              </div>
            ))}
          </div>
        )}

        {todayTasks.length > 0 && (
          <div class="task-group">
            <span class="task-group-label task-group-label--today">Today</span>
            {todayTasks.map(task => (
              <div class="task-row task-row--today">
                <span class="task-dot task-dot--today"></span>
                <span class="task-name">{task.title}</span>
                {task.project && <span class="task-tag">{task.project}</span>}
              </div>
            ))}
          </div>
        )}

        {upcomingTasks.length > 0 && (
          <div class="task-group">
            <span class="task-group-label">Upcoming</span>
            {upcomingTasks.map(task => (
              <div class="task-row">
                <span class="task-dot"></span>
                <span class="task-name">{task.title}</span>
                {task.due && <span class="task-due">{task.due}</span>}
                {task.project && <span class="task-tag">{task.project}</span>}
              </div>
            ))}
          </div>
        )}
      </section>

      <div class="right-stack">
        <section class="panel agenda-panel">
          <div class="panel-header">
            <h2 class="panel-title">Agenda</h2>
          </div>
          {todayEvents.length > 0 ? (
            todayEvents.map(ev => (
              <div class="agenda-row agenda-row--now">
                <span class="agenda-time">{ev.startTime || 'All day'}</span>
                <span class="agenda-name">{ev.title}</span>
                {ev.location && <span class="agenda-loc">{ev.location}</span>}
              </div>
            ))
          ) : (
            <div class="agenda-row agenda-row--clear">
              <span class="agenda-clear-dot"></span>
              <span class="agenda-name">No meetings today</span>
            </div>
          )}
          {upcomingEvents.length > 0 && (
            <div class="agenda-divider">
              <span>Coming up</span>
            </div>
          )}
          {upcomingEvents.map(ev => (
            <div class="agenda-row">
              <span class="agenda-time">{formatEventDate(ev.date)} {ev.startTime || ''}</span>
              <span class="agenda-name">{ev.title}</span>
            </div>
          ))}
        </section>

        <section class="panel links-panel">
          <div class="panel-header">
            <h2 class="panel-title">Links</h2>
          </div>
          <div class="links-row">
            {quickLinks.map(link => (
              <a href={link.url} target="_blank" rel="noopener" class="link-chip">{link.label}</a>
            ))}
          </div>
        </section>
      </div>

    </div>

    <!-- ===== PROJECTS ROW ===== -->
    <section class="panel">
      <div class="panel-header">
        <h2 class="panel-title">Projects</h2>
        <span class="panel-count">{projects.filter(p => p.status === 'active').length} active</span>
      </div>
      <div class="project-table">
        {projects.filter(p => p.status === 'active').map(project => (
          <div class="project-row">
            <span class="project-health project-health--active"></span>
            <span class="project-code">{project.code}</span>
            <span class="project-name">{project.name}</span>
            <span class="project-client">{project.client}</span>
            <div class="project-links">
              {project.links?.map(link => (
                <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ACTIVITY FEED ===== -->
    <section class="panel">
      <div class="panel-header">
        <h2 class="panel-title">Activity</h2>
        <a href={`${base}log/`} class="panel-link">Full log &rarr;</a>
      </div>
      <div class="feed">
        {recentLog.map(entry => (
          <details class="feed-item">
            <summary class="feed-summary">
              <span class={`feed-dot feed-dot--${entry.source}`}></span>
              <span class="feed-title">{entry.title}</span>
              <span class={`feed-source feed-source--${entry.source}`}>{entry.source}</span>
              <span class="feed-date">{entry.date}</span>
            </summary>
            <p class="feed-detail">{entry.content}</p>
          </details>
        ))}
      </div>
    </section>

  </div>
</Base>

<script>
  async function loadWeather() {
    const el = document.getElementById('weather-inline');
    if (!el) return;
    try {
      const res = await fetch(
        'https://api.open-meteo.com/v1/forecast?latitude=51.5074&longitude=-0.1278&current=temperature_2m,weather_code&timezone=Europe/London'
      );
      const data = await res.json();
      const temp = Math.round(data.current.temperature_2m);
      const code = data.current.weather_code;
      const icon = weatherIcon(code);
      el.textContent = `${icon} ${temp}°C London`;
    } catch {
      // silent fail
    }
  }

  function weatherIcon(code: number): string {
    if (code === 0) return '☀️';
    if (code <= 3) return '⛅';
    if (code <= 48) return '☁️';
    if (code <= 67) return '🌧️';
    if (code <= 77) return '❄️';
    if (code <= 86) return '🌨️';
    if (code <= 99) return '⚡';
    return '🌤️';
  }

  loadWeather();
</script>

<style>
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* ===== STATUS BAR ===== */
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-fg-muted);
    letter-spacing: 0.02em;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .status-date {
    color: var(--color-fg);
    font-weight: 500;
  }

  .status-sep {
    color: var(--color-fg-subtle);
  }

  .status-right {
    font-size: 0.65rem;
  }

  /* ===== ALERT BANNER ===== */
  .alert-banner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius);
    background: var(--color-accent-dim);
    border: 1px solid rgba(56, 189, 248, 0.2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    letter-spacing: 0.01em;
  }

  .alert-banner--warn {
    background: rgba(248, 113, 113, 0.08);
    border-color: rgba(248, 113, 113, 0.2);
    color: var(--color-danger);
  }

  .alert-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ===== PANELS ===== */
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
  }

  .panel-count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-fg-subtle);
    background: var(--color-surface-raised);
    padding: 0.15em 0.5em;
    border-radius: 3px;
  }

  .panel-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-fg-subtle);
    transition: color 0.15s;
  }

  .panel-link:hover {
    color: var(--color-accent);
  }

  /* ===== TOP GRID ===== */
  .grid-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .right-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (max-width: 720px) {
    .grid-top {
      grid-template-columns: 1fr;
    }
  }

  /* ===== TASKS ===== */
  .task-group {
    margin-bottom: var(--space-sm);
  }

  .task-group:last-child {
    margin-bottom: 0;
  }

  .task-group-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-subtle);
    margin-bottom: var(--space-xs);
    padding-left: 18px;
  }

  .task-group-label--overdue { color: var(--color-danger); }
  .task-group-label--today { color: var(--color-accent); }

  .task-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 5px var(--space-sm);
    border-radius: 4px;
    transition: background 0.1s;
    flex-wrap: wrap;
  }

  .task-row:hover {
    background: var(--color-surface-raised);
  }

  .task-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .task-dot--overdue { background: var(--color-danger); }
  .task-dot--today { background: var(--color-accent); }

  .task-name {
    font-size: 0.78rem;
    font-weight: 500;
    flex: 1;
    min-width: 0;
  }

  .task-row--overdue .task-name { color: var(--color-danger); }
  .task-row--today .task-name { color: var(--color-accent); }

  .task-tag {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-fg-subtle);
    background: var(--color-surface-raised);
    padding: 0.1em 0.45em;
    border-radius: 3px;
    white-space: nowrap;
  }

  .task-due {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }

  /* ===== AGENDA ===== */
  .agenda-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 5px var(--space-sm);
    border-radius: 4px;
    flex-wrap: wrap;
  }

  .agenda-row--now {
    background: var(--color-accent-dim);
    border-left: 2px solid var(--color-accent);
    padding-left: calc(var(--space-sm) - 2px);
  }

  .agenda-row--clear {
    border-left: 2px solid var(--color-success);
    padding-left: calc(var(--space-sm) - 2px);
    opacity: 0.6;
  }

  .agenda-clear-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
  }

  .agenda-time {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-fg-muted);
    white-space: nowrap;
    min-width: 50px;
  }

  .agenda-name {
    font-size: 0.78rem;
    font-weight: 500;
    flex: 1;
    min-width: 0;
  }

  .agenda-loc {
    font-size: 0.65rem;
    color: var(--color-fg-subtle);
    width: 100%;
    padding-left: 62px;
  }

  .agenda-divider {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    padding: var(--space-sm) var(--space-sm) var(--space-2xs);
  }

  /* ===== LINKS ===== */
  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .link-chip {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-fg-muted);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    padding: 4px 10px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.12s;
    white-space: nowrap;
  }

  .link-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    text-decoration: none;
  }

  /* ===== PROJECTS TABLE ===== */
  .project-table {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .project-row {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-sm);
    border-radius: 4px;
    transition: background 0.1s;
    flex-wrap: wrap;
  }

  .project-row:hover {
    background: var(--color-surface-raised);
  }

  .project-health {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-health--active { background: var(--color-success); }
  .project-health--paused { background: var(--color-warn); }
  .project-health--done { background: var(--color-fg-subtle); }

  .project-code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    padding: 0.15em 0.5em;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .project-name {
    font-size: 0.82rem;
    font-weight: 600;
    flex: 1;
    min-width: 120px;
  }

  .project-client {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .project-links {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .project-links a {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--color-fg-subtle);
    border: 1px solid var(--color-border);
    padding: 2px 8px;
    border-radius: 3px;
    transition: all 0.12s;
  }

  .project-links a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .project-row {
      gap: var(--space-sm);
    }
    .project-links {
      width: 100%;
      padding-left: 24px;
    }
  }

  /* ===== ACTIVITY FEED ===== */
  .feed {
    display: flex;
    flex-direction: column;
  }

  .feed-item {
    border-bottom: 1px solid var(--color-border);
  }

  .feed-item:last-child {
    border-bottom: none;
  }

  .feed-summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 7px var(--space-sm);
    border-radius: 4px;
    cursor: pointer;
    list-style: none;
    transition: background 0.1s;
  }

  .feed-summary::-webkit-details-marker { display: none; }
  .feed-summary::marker { display: none; content: ''; }

  .feed-summary:hover {
    background: var(--color-surface-raised);
  }

  .feed-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-fg-subtle);
  }

  .feed-dot--slack { background: #e01e5a; }
  .feed-dot--email { background: var(--color-accent); }
  .feed-dot--todoist { background: var(--color-danger); }
  .feed-dot--obsidian { background: var(--color-purple); }
  .feed-dot--manual { background: var(--color-fg-subtle); }

  .feed-title {
    font-size: 0.78rem;
    font-weight: 500;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed-source {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15em 0.4em;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .feed-source--slack { color: #e01e5a; background: rgba(224, 30, 90, 0.1); }
  .feed-source--email { color: var(--color-accent); background: var(--color-accent-dim); }
  .feed-source--todoist { color: var(--color-danger); background: rgba(248, 113, 113, 0.08); }
  .feed-source--obsidian { color: var(--color-purple); background: rgba(167, 139, 250, 0.1); }
  .feed-source--manual { color: var(--color-fg-muted); background: var(--color-surface-raised); }

  .feed-date {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .feed-detail {
    font-size: 0.78rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    padding: 0 var(--space-sm) var(--space-sm) 22px;
  }
</style>
