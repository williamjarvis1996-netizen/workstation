---
import Base from '../layouts/Base.astro';
const clientId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_CLIENT_ID || '';
const base = import.meta.env.BASE_URL;
---
<Base>
  <div id="workstation" data-client-id={clientId}>
    <div class="hero">
      <div><p class="eyebrow" id="day-label">London</p><h1>Your day</h1></div>
      <div class="weather" aria-label="London weather">
        <p class="eyebrow">London weather</p>
        <p class="weather-main" id="weather-main">Loading weather…</p>
        <p class="muted" id="weather-details"></p>
      </div>
    </div>
    <div class="summary-grid" aria-label="Day at a glance">
      <a href="#agenda" class="metric"><span class="eyebrow">Next up</span><strong id="next-value">Connect calendar</strong><span id="next-detail">Live agenda</span></a>
      <a href="#tasks" class="metric"><span class="eyebrow">Needs attention</span><strong id="task-value">0 due</strong><span id="task-detail">Open tasks</span></a>
      <a href="#agenda" class="metric"><span class="eyebrow">Focus window</span><strong id="focus-value">—</strong><span id="focus-detail">Calculated from your calendar</span></a>
    </div>
    <div class="workspace-grid">
      <section class="panel" id="agenda">
        <header class="panel-header"><h2>Agenda</h2><button type="button" class="quiet" id="calendar-action">Connect Google Calendar</button></header>
        <p id="calendar-status" class="muted status" role="status"></p>
        <div id="agenda-list"></div>
      </section>
      <section class="panel" id="tasks">
        <header class="panel-header"><h2>Tasks</h2><button type="button" class="quiet" id="task-toggle" aria-controls="task-form" aria-expanded="false">Add task</button></header>
        <form id="task-form" class="task-form" hidden>
          <label>Task <input name="title" maxlength="240" required /></label>
          <div class="form-row"><label>Due <input type="date" name="due" /></label><label>Priority <select name="priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></label></div>
          <label>Project <input name="project" maxlength="120" /></label>
          <div class="button-row"><button type="submit">Save task</button><button type="button" class="quiet" id="task-cancel">Cancel</button></div>
        </form>
        <div class="filters" aria-label="Task filter">
          <button type="button" data-task-filter="open" aria-pressed="true">Open</button>
          <button type="button" data-task-filter="completed" aria-pressed="false">Completed</button>
        </div>
        <p id="task-status" role="status" class="muted status"></p>
        <div id="task-list"></div>
      </section>
      <section class="panel">
        <header class="panel-header"><h2>Projects</h2><span id="project-count" class="muted"></span></header>
        <div id="project-list"></div>
      </section>
      <section class="panel">
        <header class="panel-header"><h2>Activity</h2><a href={base + 'log/'}>View log <span aria-hidden="true">↗</span></a></header>
        <div id="activity-list"></div>
      </section>
    </div>
    <details class="panel settings" id="settings">
      <summary>Settings and data</summary>
      <form id="calendar-settings">
        <label for="oauth-client">Google OAuth web client ID</label>
        <input id="oauth-client" placeholder="…apps.googleusercontent.com" autocomplete="off" />
        <label for="calendar-ids">Calendar IDs</label>
        <input id="calendar-ids" placeholder="primary" autocomplete="off" aria-describedby="calendar-help" />
        <p id="calendar-help" class="muted">Use commas for multiple calendars. Your primary calendar is the default.</p>
        <div class="button-row"><button type="submit">Save calendar settings</button><button class="quiet" type="button" id="calendar-disconnect" hidden>Disconnect</button></div>
      </form>
      <div class="data-settings">
        <h2>Browser data</h2>
        <p class="muted">Tasks and imported data are stored in this browser. Import replaces the current snapshot.</p>
        <div class="button-row">
          <button type="button" class="quiet" id="export-data">Export JSON</button>
          <button type="button" class="quiet" id="import-data">Import JSON</button>
          <input id="snapshot-file" type="file" accept=".json,application/json" hidden />
        </div>
      </div>
      <p id="settings-status" class="muted status" role="status"></p>
    </details>
  </div>
</Base>

<script>
  import '../lib/dashboard.mjs';
</script>
