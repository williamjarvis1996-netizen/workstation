---
import Base from '../layouts/Base.astro';
import { dashboard, isDemo } from '../content/dashboard';
const { projects, tasks, log, quickLinks, calendarEvents, lastUpdated,
  exerciseSessions, marathonTraining, creativeProjects, personalGoals } = dashboard;
const recentLog = log.slice(0, 8);
const base = import.meta.env.BASE_URL;
const clientId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_CLIENT_ID || '';

const activeProjects = projects.filter(p => p.status === 'active');

const sourceColors: Record<string, string> = {
  slack: '#e01e5a',
  email: '#38bdf8',
  todoist: '#f87171',
  obsidian: '#a78bfa',
  manual: '#64748b',
};

const healthColors: Record<string, string> = {
  'on-track': 'var(--color-success)',
  'at-risk': 'var(--color-warn)',
  'blocked': 'var(--color-danger)',
};

const marathon = marathonTraining;
const recentExercise = exerciseSessions.slice(0, 4);
---

<Base title="Workstation">
  <div class="dashboard" id="blue-dashboard" data-client-id={clientId} data-demo={isDemo ? "true" : "false"}
    data-tasks={JSON.stringify(tasks)} data-calendar={JSON.stringify(calendarEvents)}>
    {isDemo && <p class="top-sync">Sample data</p>}

    <!-- ===== DATE + WEATHER BAR ===== -->
    <section class="top-bar">
      <div class="top-date">
        <span class="top-day-name" id="day-name"></span>
        <span class="top-day-num" id="day-number"></span>
        <span class="top-month" id="day-month"></span>
      </div>
      <div class="top-meta">
        <span class="top-weather" id="weather-inline">Loading London weather…</span>
        <span class="top-sync" id="weather-forecast"></span>
        {lastUpdated && <span class="top-sync">Snapshot {lastUpdated}</span>}
      </div>
    </section>

    <!-- ===== ALERT BANNER ===== -->
    <section class="alert" id="dashboard-alert" hidden>
      <div class="alert-items" id="alert-items"></div>
    </section>

    <!-- ===== QUICK LINKS BAR ===== -->
    <nav class="links-bar">
      {quickLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener" class="qlink">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
    </nav>

    <!-- ===== ROW 1: TODAY PANEL ===== -->
    <section class="panel panel--today">
      <div class="panel-head">
        <h2>Today</h2>
        <span class="pill" id="timeline-count">0 items</span>
      </div>
      <div class="timeline" id="today-timeline"></div>
      <details class="calendar-settings" id="calendar-settings">
        <summary>Calendar settings</summary>
        <form id="calendar-form">
          <label>Google OAuth web client ID <input name="client" autocomplete="off" placeholder="…apps.googleusercontent.com" /></label>
          <label>Calendar IDs <input name="ids" value="primary" /></label>
          <button type="submit">Save settings</button>
          <button type="button" id="calendar-connect">Connect Google Calendar</button>
          <button type="button" id="calendar-disconnect" hidden>Disconnect</button>
        </form>
        <p class="top-sync" id="calendar-status" role="status"></p>
      </details>
    </section>

    <!-- ===== ROW 2: PROJECT CARDS ===== -->
    <section class="section-wrap">
      <div class="section-header">
        <h2 class="section-title">Projects</h2>
        <span class="pill">{activeProjects.length} active</span>
      </div>
      <div class="project-grid">
        {activeProjects.map(project => (
          <div class="pcard" style={`--health-color: ${healthColors[project.health]}`}>
            <div class="pcard-top">
              <span class="pcard-code">{project.code}</span>
              <span class={`pcard-health pcard-health--${project.health}`}>{project.health.replace('-', ' ')}</span>
            </div>
            <div class="pcard-name">{project.name}</div>
            <div class="pcard-client">{project.client}</div>
            <div class="pcard-phase">{project.phase}</div>
            <div class="pcard-status">{project.statusSummary}</div>
            {project.nextMilestone && (
              <div class="pcard-milestone">
                <span class="pcard-milestone-label">Next:</span> {project.nextMilestone}
                {project.nextMilestoneDate && <span class="pcard-milestone-date">{project.nextMilestoneDate}</span>}
              </div>
            )}
            {project.links && project.links.length > 0 && (
              <div class="pcard-links">
                {project.links.map(link => (
                  <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ===== ROW 3: PERSONAL SECTION ===== -->
    <section class="section-wrap">
      <div class="section-header">
        <h2 class="section-title">Personal</h2>
      </div>
      <div class="personal-grid">

        <!-- Marathon Training -->
        <div class="personal-card personal-card--marathon">
          <div class="pc-head">
            <h3>Marathon Training</h3>
            {marathon && <span class="pc-badge pc-badge--accent" id="weeks-to-race" data-race-date={marathon.raceDate}>{marathon.weeksToRace}w to race</span>}
          </div>
          {marathon ? <div><div class="marathon-stats">
            <div class="mstat">
              <span class="mstat-val">{marathon.raceName.split(' ').slice(-1)}</span>
              <span class="mstat-label">Race</span>
            </div>
            <div class="mstat">
              <span class="mstat-val">{marathon.targetTime.replace('Sub-', '<')}</span>
              <span class="mstat-label">Target</span>
            </div>
            <div class="mstat">
              <span class="mstat-val">Wk {marathon.weekNumber}</span>
              <span class="mstat-label">{marathon.currentPhase}</span>
            </div>
          </div>
          <div class="marathon-detail">
            <div class="md-row">
              <span class="md-label">Last long run</span>
              <span class="md-val">{marathon.lastLongRun}</span>
            </div>
            <div class="md-row">
              <span class="md-label">Next target</span>
              <span class="md-val">{marathon.nextLongRunTarget}</span>
            </div>
            <div class="md-row">
              <span class="md-label">Structure</span>
              <span class="md-val">{marathon.weeklyStructure}</span>
            </div>
          </div></div> : <p class="empty-state-sm">Training snapshot unavailable in the demo.</p>}
        </div>

        <!-- Recent Exercise -->
        <div class="personal-card personal-card--exercise">
          <div class="pc-head">
            <h3>Recent Exercise</h3>
            <span class="pc-badge pc-badge--green">{exerciseSessions.length} sessions</span>
          </div>
          <div class="exercise-list">
            {recentExercise.map(session => (
              <div class={`ex-item ex-item--${session.type}`}>
                <div class="ex-type">{session.type}</div>
                <div class="ex-body">
                  <span class="ex-title">{session.title}</span>
                  <span class="ex-meta">
                    {session.distance && `${session.distance} `}
                    {session.duration && `${session.duration} `}
                    {session.avgHR && `HR ${session.avgHR} `}
                    {session.volume && `Vol ${session.volume}`}
                  </span>
                </div>
                <div class="ex-date">{session.date.slice(5)}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Creative Projects -->
        <div class="personal-card personal-card--creative">
          <div class="pc-head">
            <h3>Creative</h3>
            <span class="pc-badge pc-badge--purple">{creativeProjects.length} projects</span>
          </div>
          <div class="creative-list">
            {creativeProjects.map(proj => (
              <div class="cr-item">
                <div class="cr-top">
                  <span class="cr-name">{proj.name}</span>
                  <span class="cr-type">{proj.type}</span>
                </div>
                <div class="cr-status">{proj.status}</div>
                <div class="cr-summary">{proj.summary}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Goals -->
        <div class="personal-card personal-card--goals">
          <div class="pc-head">
            <h3>Goals</h3>
          </div>
          <div class="goals-list">
            {personalGoals.map(goal => (
              <div class="goal-item">
                <div class="goal-top">
                  <span class="goal-name">{goal.name}</span>
                  <span class="goal-cat">{goal.category}</span>
                </div>
                <div class="goal-detail">{goal.detail}</div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ===== ROW 4: UPCOMING + ACTIVITY ===== -->
    <div class="grid-bottom">

      <!-- UPCOMING -->
      <section class="panel">
        <div class="panel-head">
          <h2>Upcoming</h2>
          <span class="pill">next 5 days</span>
        </div>
        <div id="upcoming-tasks"></div>
      </section>

      <!-- ACTIVITY FEED -->
      <section class="panel">
        <div class="panel-head">
          <h2>Activity</h2>
          <a href={`${base}log/`} class="panel-link">Full log &rarr;</a>
        </div>
        <div class="feed-grid">
          {recentLog.map(entry => (
            <details class="feed-item">
              <summary>
                <span class="feed-dot" style={`background: ${sourceColors[entry.source]}`}></span>
                <span class="feed-title">{entry.title}</span>
                <span class="feed-source" style={`background: ${sourceColors[entry.source]}22; color: ${sourceColors[entry.source]}`}>{entry.source}</span>
                <span class="feed-date">{entry.date}</span>
              </summary>
              <p class="feed-detail">{entry.content}</p>
            </details>
          ))}
        </div>
      </section>

    </div>

  </div>
</Base>

<script>
  import '../lib/blue-dashboard.mjs';
</script>

<style is:global>
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ===== TOP BAR ===== */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .top-date {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .top-day-name {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  .top-day-num {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .top-month {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  .top-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-subtle);
  }

  /* ===== ALERT BANNER ===== */
  .alert {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid;
  }

  .alert--danger {
    background: linear-gradient(135deg, rgba(248, 113, 113, 0.12), rgba(248, 113, 113, 0.04));
    border-color: rgba(248, 113, 113, 0.25);
  }

  .alert--info {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(56, 189, 248, 0.03));
    border-color: rgba(56, 189, 248, 0.2);
  }

  .alert-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .alert-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .alert-item--danger { color: var(--color-danger); }
  .alert-item--warn { color: var(--color-warn); }
  .alert-item--info { color: var(--color-accent); }

  .alert-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ===== QUICK LINKS BAR ===== */
  .links-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .qlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-fg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: var(--radius);
    transition: all 0.15s;
  }

  .qlink svg {
    opacity: 0.4;
    transition: opacity 0.15s, transform 0.15s;
  }

  .qlink:hover {
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border-color: rgba(56, 189, 248, 0.3);
    text-decoration: none;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.1);
  }

  .qlink:hover svg {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  /* ===== PANELS ===== */
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: 0 0 24px rgba(0, 0, 0, 0.15);
  }

  .panel--today {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.04), rgba(167, 139, 250, 0.03));
    border-color: rgba(56, 189, 248, 0.12);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .panel-head h2 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    padding: 4px 10px;
    border-radius: 20px;
  }

  .panel-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-fg-subtle);
    transition: color 0.15s;
  }

  .panel-link:hover { color: var(--color-accent); }

  /* ===== TODAY TIMELINE ===== */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: relative;
    padding-left: 4px;
  }

  .tl-item {
    display: grid;
    grid-template-columns: 60px 12px 1fr;
    align-items: center;
    gap: var(--space-sm);
    padding: 10px 8px;
    border-radius: var(--radius);
    transition: background 0.12s;
  }

  .tl-item:hover { background: var(--color-surface-raised); }

  .tl-time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-fg-subtle);
    text-align: right;
  }

  .tl-item--overdue .tl-time { color: var(--color-danger); font-size: 0.6rem; }

  .tl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    justify-self: center;
  }

  .tl-dot--event { background: var(--color-accent); box-shadow: 0 0 8px rgba(56, 189, 248, 0.4); }
  .tl-dot--task { background: var(--color-warn); }
  .tl-dot--overdue { background: var(--color-danger); animation: pulse 2s ease-in-out infinite; }

  .tl-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tl-label {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .tl-item--overdue .tl-label { color: var(--color-danger); }

  .tl-detail {
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }

  .empty-state {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    color: var(--color-fg-muted);
    font-size: 0.9rem;
  }

  .empty-icon {
    color: var(--color-success);
    font-size: 1.2rem;
  }

  .empty-state-sm {
    color: var(--color-fg-subtle);
    font-size: 0.85rem;
    padding: var(--space-sm) 0;
  }

  /* ===== SECTION HEADERS ===== */
  .section-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .section-title {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* ===== PROJECT CARDS ===== */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-md);
  }

  .pcard {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--health-color, var(--color-success));
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.12);
  }

  .pcard:hover {
    border-color: var(--color-border-hover);
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
  }

  .pcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pcard-code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    padding: 3px 10px;
    border-radius: 4px;
  }

  .pcard-health {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 4px;
  }

  .pcard-health--on-track { background: rgba(74, 222, 128, 0.12); color: var(--color-success); }
  .pcard-health--at-risk { background: rgba(251, 191, 36, 0.12); color: var(--color-warn); }
  .pcard-health--blocked { background: rgba(248, 113, 113, 0.12); color: var(--color-danger); }

  .pcard-name {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .pcard-client {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }

  .pcard-phase {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-purple);
  }

  .pcard-status {
    font-size: 0.85rem;
    color: var(--color-fg-muted);
    line-height: 1.5;
  }

  .pcard-milestone {
    font-size: 0.8rem;
    color: var(--color-fg);
    padding-top: 4px;
    border-top: 1px solid var(--color-border);
    margin-top: 4px;
  }

  .pcard-milestone-label {
    font-weight: 600;
    color: var(--color-accent);
  }

  .pcard-milestone-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    margin-left: 8px;
  }

  .pcard-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .pcard-links a {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border-hover);
    padding: 4px 12px;
    border-radius: 6px;
    transition: all 0.12s;
  }

  .pcard-links a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    text-decoration: none;
  }

  /* ===== PERSONAL GRID ===== */
  .personal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  .personal-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.12);
  }

  .personal-card--marathon { border-top: 3px solid var(--color-accent); }
  .personal-card--exercise { border-top: 3px solid var(--color-success); }
  .personal-card--creative { border-top: 3px solid var(--color-purple); }
  .personal-card--goals { border-top: 3px solid var(--color-orange); }

  .pc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .pc-head h3 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-muted);
  }

  .pc-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .pc-badge--accent { background: var(--color-accent-dim); color: var(--color-accent); }
  .pc-badge--green { background: rgba(74, 222, 128, 0.12); color: var(--color-success); }
  .pc-badge--purple { background: rgba(167, 139, 250, 0.12); color: var(--color-purple); }

  /* Marathon stats */
  .marathon-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .mstat {
    text-align: center;
    padding: var(--space-sm);
    background: var(--color-surface-raised);
    border-radius: var(--radius);
  }

  .mstat-val {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .mstat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-subtle);
  }

  .marathon-detail {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .md-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }

  .md-label { color: var(--color-fg-muted); }
  .md-val { font-weight: 500; }

  /* Exercise list */
  .exercise-list {
    display: flex;
