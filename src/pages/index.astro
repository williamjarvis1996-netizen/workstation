---
import Base from '../layouts/Base.astro';
import { projects, tasks, log, quickLinks, calendarEvents, lastUpdated } from '../content/dashboard';

const activeTasks = tasks.filter(t => !t.completed);
const recentLog = log.slice(0, 8);
const base = import.meta.env.BASE_URL;

const today = new Date();
const dayName = today.toLocaleDateString('en-GB', { weekday: 'long' });
const dayNum = today.getDate();
const monthName = today.toLocaleDateString('en-GB', { month: 'long' });
const year = today.getFullYear();
const todayStr = today.toISOString().slice(0, 10);

const todayEvents = calendarEvents.filter(e => e.date === todayStr);
const upcomingEvents = calendarEvents.filter(e => e.date > todayStr).slice(0, 3);
const nextEvent = todayEvents[0] || upcomingEvents[0];

const overdueTasks = activeTasks.filter(t => t.due && t.due < todayStr);
const todayTasks = activeTasks.filter(t => t.due === todayStr);
const upcomingTasks = activeTasks.filter(t => !t.due || t.due > todayStr);

function formatEventDate(dateStr: string): string {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
}

function getNextMeetingLabel(): string {
  if (!nextEvent) return '';
  if (nextEvent.date === todayStr && nextEvent.startTime) {
    return `Next meeting at ${nextEvent.startTime}`;
  }
  if (nextEvent.date > todayStr) {
    const d = new Date(nextEvent.date + 'T00:00:00');
    const diff = Math.ceil((d.getTime() - today.getTime()) / 86400000);
    const timeStr = nextEvent.startTime ? ` at ${nextEvent.startTime}` : '';
    return `Next meeting in ${diff}d${timeStr}`;
  }
  return '';
}

const sourceColors: Record<string, string> = {
  slack: '#e01e5a',
  email: '#38bdf8',
  todoist: '#f87171',
  obsidian: '#a78bfa',
  manual: '#71717a',
};
---

<Base title="Workstation">
  <div class="dashboard">

    <!-- ===== DATE + WEATHER BAR ===== -->
    <section class="top-bar">
      <div class="top-date">
        <span class="top-day-name">{dayName}</span>
        <span class="top-day-num">{dayNum}</span>
        <span class="top-month">{monthName} {year}</span>
      </div>
      <div class="top-meta">
        <span class="top-weather" id="weather-inline"></span>
        <span class="top-sync">Updated {lastUpdated}</span>
      </div>
    </section>

    <!-- ===== ALERT BANNER ===== -->
    {(overdueTasks.length > 0 || todayTasks.length > 0 || nextEvent) && (
      <section class={`alert ${overdueTasks.length > 0 ? 'alert--danger' : 'alert--info'}`}>
        <div class="alert-items">
          {overdueTasks.length > 0 && (
            <span class="alert-item alert-item--danger">
              <span class="alert-pip"></span>
              {overdueTasks.length} overdue
            </span>
          )}
          {todayTasks.length > 0 && (
            <span class="alert-item alert-item--warn">
              <span class="alert-pip"></span>
              {todayTasks.length} due today
            </span>
          )}
          {getNextMeetingLabel() && (
            <span class="alert-item alert-item--info">
              <span class="alert-pip"></span>
              {getNextMeetingLabel()}
            </span>
          )}
        </div>
      </section>
    )}

    <!-- ===== QUICK LINKS BAR ===== -->
    <nav class="links-bar">
      {quickLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener" class="qlink">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
    </nav>

    <!-- ===== MAIN GRID: Tasks + Right Column ===== -->
    <div class="grid-main">

      <!-- TASKS -->
      <section class="panel">
        <div class="panel-head">
          <h2>Tasks</h2>
          <span class="pill">{activeTasks.length} open</span>
        </div>

        {overdueTasks.length > 0 && (
          <div class="task-section">
            <div class="task-section-label task-section-label--danger">Overdue</div>
            {overdueTasks.map(task => (
              <div class="task task--danger">
                <div class="task-indicator task-indicator--danger"></div>
                <div class="task-body">
                  <span class="task-title">{task.title}</span>
                  {task.project && <span class="task-project">{task.project}</span>}
                </div>
                {task.due && <span class="task-due">{task.due}</span>}
              </div>
            ))}
          </div>
        )}

        {todayTasks.length > 0 && (
          <div class="task-section">
            <div class="task-section-label task-section-label--accent">Today</div>
            {todayTasks.map(task => (
              <div class="task task--accent">
                <div class="task-indicator task-indicator--accent"></div>
                <div class="task-body">
                  <span class="task-title">{task.title}</span>
                  {task.project && <span class="task-project">{task.project}</span>}
                </div>
              </div>
            ))}
          </div>
        )}

        {upcomingTasks.length > 0 && (
          <div class="task-section">
            <div class="task-section-label">Upcoming</div>
            {upcomingTasks.map(task => (
              <div class="task">
                <div class="task-indicator"></div>
                <div class="task-body">
                  <span class="task-title">{task.title}</span>
                  {task.project && <span class="task-project">{task.project}</span>}
                </div>
                {task.due && <span class="task-due">{task.due}</span>}
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- RIGHT COLUMN: Agenda + Projects -->
      <div class="right-col">

        <!-- AGENDA -->
        <section class="panel">
          <div class="panel-head">
            <h2>Agenda</h2>
          </div>
          {todayEvents.length > 0 ? (
            todayEvents.map(ev => (
              <div class="event event--now">
                <div class="event-time">{ev.startTime || 'All day'}{ev.endTime ? ` - ${ev.endTime}` : ''}</div>
                <div class="event-title">{ev.title}</div>
                {ev.location && <div class="event-loc">{ev.location}</div>}
              </div>
            ))
          ) : (
            <div class="event event--clear">
              <div class="event-title">No meetings today</div>
              <div class="event-loc">Calendar is clear</div>
            </div>
          )}
          {upcomingEvents.length > 0 && (
            <>
              <div class="divider-label">Coming up</div>
              {upcomingEvents.map(ev => (
                <div class="event">
                  <div class="event-time">{formatEventDate(ev.date)} {ev.startTime || ''}</div>
                  <div class="event-title">{ev.title}</div>
                  {ev.location && <div class="event-loc">{ev.location}</div>}
                </div>
              ))}
            </>
          )}
        </section>

        <!-- PROJECTS -->
        <section class="panel">
          <div class="panel-head">
            <h2>Projects</h2>
            <span class="pill">{projects.filter(p => p.status === 'active').length} active</span>
          </div>
          {projects.filter(p => p.status === 'active').map(project => (
            <div class={`project project--${project.priority}`}>
              <div class="project-top">
                <span class="project-code">{project.code}</span>
                <span class="project-name">{project.name}</span>
              </div>
              <div class="project-bottom">
                <span class="project-client">{project.client}</span>
                <div class="project-links">
                  {project.links?.map(link => (
                    <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </section>

      </div>
    </div>

    <!-- ===== ACTIVITY FEED ===== -->
    <section class="panel">
      <div class="panel-head">
        <h2>Activity</h2>
        <a href={`${base}log/`} class="panel-link">View full log &rarr;</a>
      </div>
      <div class="feed-grid">
        {recentLog.map(entry => (
          <details class="feed-item">
            <summary>
              <span class="feed-dot" style={`background: ${sourceColors[entry.source]}`}></span>
              <span class="feed-title">{entry.title}</span>
              <span class="feed-source" style={`background: ${sourceColors[entry.source]}22; color: ${sourceColors[entry.source]}`}>{entry.source}</span>
              <span class="feed-date">{entry.date}</span>
            </summary>
            <p class="feed-detail">{entry.content}</p>
          </details>
        ))}
      </div>
    </section>

  </div>
</Base>

<script>
  async function loadWeather() {
    const el = document.getElementById('weather-inline');
    if (!el) return;
    try {
      const res = await fetch(
        'https://api.open-meteo.com/v1/forecast?latitude=51.5074&longitude=-0.1278&current=temperature_2m,weather_code&timezone=Europe/London'
      );
      const data = await res.json();
      const temp = Math.round(data.current.temperature_2m);
      const code = data.current.weather_code;
      const icon = weatherIcon(code);
      el.textContent = `${icon} ${temp}°C London`;
    } catch {
      // silent fail
    }
  }

  function weatherIcon(code: number): string {
    if (code === 0) return '☀️';
    if (code <= 3) return '⛅';
    if (code <= 48) return '☁️';
    if (code <= 67) return '🌧️';
    if (code <= 77) return '❄️';
    if (code <= 86) return '🌨️';
    if (code <= 99) return '⚡';
    return '🌤️';
  }

  loadWeather();
</script>

<style>
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ===== TOP BAR ===== */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .top-date {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .top-day-name {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  .top-day-num {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-accent), var(--color-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .top-month {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-fg-muted);
  }

  .top-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-subtle);
  }

  /* ===== ALERT BANNER ===== */
  .alert {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid;
  }

  .alert--danger {
    background: linear-gradient(135deg, rgba(248, 113, 113, 0.12), rgba(248, 113, 113, 0.04));
    border-color: rgba(248, 113, 113, 0.25);
  }

  .alert--info {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(56, 189, 248, 0.03));
    border-color: rgba(56, 189, 248, 0.2);
  }

  .alert-items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .alert-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .alert-item--danger { color: var(--color-danger); }
  .alert-item--warn { color: var(--color-warn); }
  .alert-item--info { color: var(--color-accent); }

  .alert-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ===== QUICK LINKS BAR ===== */
  .links-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .qlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-fg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: var(--radius);
    transition: all 0.15s;
  }

  .qlink svg {
    opacity: 0.4;
    transition: opacity 0.15s, transform 0.15s;
  }

  .qlink:hover {
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border-color: rgba(56, 189, 248, 0.3);
    text-decoration: none;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.1);
  }

  .qlink:hover svg {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  /* ===== PANELS ===== */
  .panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .panel-head h2 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-fg-muted);
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    padding: 4px 10px;
    border-radius: 20px;
  }

  .panel-link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-fg-subtle);
    transition: color 0.15s;
  }

  .panel-link:hover {
    color: var(--color-accent);
  }

  /* ===== MAIN GRID ===== */
  .grid-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .right-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (max-width: 768px) {
    .grid-main {
      grid-template-columns: 1fr;
    }
  }

  /* ===== TASKS ===== */
  .task-section {
    margin-bottom: var(--space-md);
  }

  .task-section:last-child {
    margin-bottom: 0;
  }

  .task-section-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
    padding: var(--space-xs) 0 var(--space-sm) 16px;
  }

  .task-section-label--danger { color: var(--color-danger); }
  .task-section-label--accent { color: var(--color-accent); }

  .task {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    padding: 10px 12px;
    border-radius: var(--radius);
    transition: background 0.12s;
  }

  .task:hover {
    background: var(--color-surface-raised);
  }

  .task-indicator {
    width: 4px;
    min-height: 20px;
    align-self: stretch;
    border-radius: 2px;
    background: var(--color-fg-subtle);
    opacity: 0.3;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .task-indicator--danger { background: var(--color-danger); opacity: 1; }
  .task-indicator--accent { background: var(--color-accent); opacity: 1; }

  .task-body {
    flex: 1;
    min-width: 0;
  }

  .task-title {
    display: block;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .task--danger .task-title { color: var(--color-danger); }
  .task--accent .task-title { color: var(--color-accent); }

  .task-project {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    background: var(--color-surface-raised);
    padding: 2px 8px;
    border-radius: 4px;
    margin-top: 4px;
  }

  .task-due {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 2px;
  }

  /* ===== AGENDA / EVENTS ===== */
  .event {
    padding: 12px 16px;
    border-radius: var(--radius);
    margin-bottom: var(--space-sm);
  }

  .event:last-child {
    margin-bottom: 0;
  }

  .event--now {
    background: var(--color-accent-dim);
    border-left: 3px solid var(--color-accent);
  }

  .event--clear {
    background: rgba(74, 222, 128, 0.06);
    border-left: 3px solid var(--color-success);
  }

  .event-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-fg-muted);
    margin-bottom: 2px;
  }

  .event-title {
    font-size: 1rem;
    font-weight: 600;
  }

  .event-loc {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    margin-top: 2px;
  }

  .divider-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-subtle);
    padding: var(--space-sm) 0;
  }

  /* ===== PROJECTS ===== */
  .project {
    padding: 16px;
    border-radius: var(--radius);
    border-left: 4px solid var(--color-success);
    background: rgba(74, 222, 128, 0.04);
    margin-bottom: var(--space-sm);
    transition: background 0.12s;
  }

  .project:last-child {
    margin-bottom: 0;
  }

  .project:hover {
    background: rgba(74, 222, 128, 0.08);
  }

  .project--high {
    border-left-color: var(--color-danger);
    background: rgba(248, 113, 113, 0.04);
  }

  .project--high:hover {
    background: rgba(248, 113, 113, 0.08);
  }

  .project--medium {
    border-left-color: var(--color-warn);
    background: rgba(251, 191, 36, 0.04);
  }

  .project--medium:hover {
    background: rgba(251, 191, 36, 0.08);
  }

  .project-top {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: 6px;
  }

  .project-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-dim);
    padding: 3px 10px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .project-name {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .project-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .project-client {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-fg-muted);
  }

  .project-links {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .project-links a {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border-hover);
    padding: 4px 12px;
    border-radius: 6px;
    transition: all 0.12s;
  }

  .project-links a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
    text-decoration: none;
  }

  /* ===== ACTIVITY FEED ===== */
  .feed-grid {
    display: flex;
    flex-direction: column;
  }

  .feed-item {
    border-bottom: 1px solid var(--color-border);
  }

  .feed-item:last-child {
    border-bottom: none;
  }

  .feed-item summary {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 10px 8px;
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
    transition: background 0.1s;
  }

  .feed-item summary::-webkit-details-marker { display: none; }
  .feed-item summary::marker { display: none; content: ''; }

  .feed-item summary:hover {
    background: var(--color-surface-raised);
  }

  .feed-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .feed-title {
    font-size: 0.9rem;
    font-weight: 500;
    flex: 1;
    min-width: 0;
  }

  .feed-source {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .feed-date {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
    flex-shrink: 0;
  }

  .feed-detail {
    font-size: 0.9rem;
    color: var(--color-fg-muted);
    line-height: 1.65;
    padding: 0 8px var(--space-md) 26px;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 768px) {
    .top-day-num {
      font-size: 2.2rem;
    }

    .panel {
      padding: var(--space-lg);
    }

    .project-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .feed-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
