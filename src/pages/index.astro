---
import Base from '../layouts/Base.astro';
import { dashboard, isDemo } from '../content/dashboard';
const { tasks, log, quickLinks, calendarEvents, lastUpdated } = dashboard;
const workProjects = dashboard.projects.map(({ code, name, status, health, nextMilestoneDate, deadline }) =>
  ({ code, name, status, health, nextMilestoneDate, deadline }));
const recentLog = log.slice(0, 12);
const base = import.meta.env.BASE_URL;
const clientId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_CLIENT_ID || '';

const sourceColors: Record<string, string> = {
  slack: '#e01e5a',
  email: '#38bdf8',
  todoist: '#f87171',
  obsidian: '#a78bfa',
  manual: '#64748b',
};

---

<Base title="Workstation" active="overview">
  <div class="dashboard" id="blue-dashboard" data-client-id={clientId} data-demo={isDemo ? "true" : "false"}
    data-tasks={JSON.stringify(tasks)} data-calendar={JSON.stringify(calendarEvents)} data-work-projects={JSON.stringify(workProjects)}>

    <!-- ===== HERO BAR ===== -->
    <section class="hero-bar">
      <div class="hero-left">
        <div class="hero-greeting" id="hero-greeting"></div>
        <div class="overview-heading">
          <h1 id="day-name-full"></h1>
          <div class="top-date">
            <span id="day-number" class="top-day-num"></span>
            <span id="day-month"></span>
          </div>
          {isDemo && <span class="top-sync">Sample data</span>}
        </div>
      </div>
      <div class="hero-local" aria-label="London time and weather">
        <div class="hero-clock">
          <div class="analog-clock" id="analog-clock" aria-hidden="true">
            <svg viewBox="0 0 200 200" class="clock-face">
              <circle cx="100" cy="100" r="95" class="clock-ring" />
              <circle cx="100" cy="100" r="88" class="clock-inner" />
              {[...Array(12)].map((_, i) => {
                const angle = (i * 30 - 90) * (Math.PI / 180);
                const x1 = 100 + 78 * Math.cos(angle);
                const y1 = 100 + 78 * Math.sin(angle);
                const x2 = 100 + 88 * Math.cos(angle);
                const y2 = 100 + 88 * Math.sin(angle);
                return <line x1={x1} y1={y1} x2={x2} y2={y2} class={`clock-tick ${i % 3 === 0 ? 'clock-tick--major' : ''}`} />;
              })}
              {[...Array(60)].map((_, i) => {
                if (i % 5 === 0) return null;
                const angle = (i * 6 - 90) * (Math.PI / 180);
                const x1 = 100 + 84 * Math.cos(angle);
                const y1 = 100 + 84 * Math.sin(angle);
                const x2 = 100 + 88 * Math.cos(angle);
                const y2 = 100 + 88 * Math.sin(angle);
                return <line x1={x1} y1={y1} x2={x2} y2={y2} class="clock-tick clock-tick--minor" />;
              })}
              <line id="clock-hour" x1="100" y1="100" x2="100" y2="48" class="clock-hand clock-hand--hour" />
              <line id="clock-minute" x1="100" y1="100" x2="100" y2="30" class="clock-hand clock-hand--minute" />
              <line id="clock-second" x1="100" y1="105" x2="100" y2="26" class="clock-hand clock-hand--second" />
              <circle cx="100" cy="100" r="4" class="clock-center" />
            </svg>
          </div>
          <div class="overview-clock">
            <time id="overview-clock"></time>
            <span class="hero-reading-label">London time</span>
          </div>
        </div>
        <div class="hero-weather">
          <div class="weather-icon-row">
            <span class="weather-emoji" id="weather-icon" aria-hidden="true"></span>
            <div class="weather-temp">
              <span class="weather-degrees" id="weather-temp"></span>
              <span class="weather-condition" id="weather-condition" aria-busy="true"><span class="loading-skeleton"><span class="loading-label">Loading weather</span></span></span>
            </div>
          </div>
          <span class="hero-forecast" id="weather-forecast"></span>
        </div>
      </div>
    </section>

    <section class="daily-summary" aria-label="Day at a glance">
      <div class="day-stat"><span id="calendar-summary-label">Next up</span><strong id="next-meeting">Calendar disconnected</strong></div>
      <a class="day-stat task-summary-link" href={base + 'tasks/'}><span>Task triage</span><strong id="due-today" aria-busy="true"><span class="loading-skeleton"><span class="loading-label">Checking tasks</span></span></strong></a>
      <a class="day-stat task-summary-link" href={base + 'work/#portfolio-risks'}><span>Work risks</span><strong id="work-attention">Checking projects…</strong><small id="work-attention-detail" hidden></small></a>
    </section>

    <div class="day-grid">
      <section class="panel panel--today">
        <div class="panel-head">
          <h2>Agenda</h2>
          <div class="agenda-meta"><a class="panel-link" href={base + 'tasks/plan/'}>Plan today &rarr;</a><span class="top-sync" id="calendar-connection">Calendar disconnected</span><a class="panel-link" id="settings-link" href="#settings">Settings &amp; sync</a></div>
        </div>
        <div class="timeline" id="today-timeline"></div>
      </section>
      <section class="panel compact-tasks" id="tasks">
        <div class="panel-head"><h2>Task preview</h2><a class="panel-link" href={base + 'tasks/'}>All tasks &rarr;</a></div>
        <div class="task-tabs" aria-label="Filter preview">
          {['Priority', 'Today', 'Upcoming', 'Overdue'].map((label, i) => <button type="button" data-filter={label} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
        </div>
        <div id="today-tasks"></div>
        <p role="status" class="top-sync" id="task-feedback"></p>
      </section>
    </div>

    <!-- ===== QUICK LINKS BAR ===== -->
    <nav class="links-bar">
      {quickLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener" class="qlink" data-category={link.category.toLowerCase()}>
          {link.label}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
    </nav>

      <section class="panel">
        <div class="panel-head">
          <h2>Recent activity</h2><a class="panel-link" href={base + 'work/activity/'}>Work activity &rarr;</a>
        </div>
        <div class="feed-grid">
          {recentLog.map(entry => (
            <details class="feed-item">
              <summary>
                <span class="feed-dot" style={`background: ${sourceColors[entry.source]}`}></span>
                <span class="feed-title">{entry.title}</span>
                <span class="feed-source" style={`background: ${sourceColors[entry.source]}22; color: ${sourceColors[entry.source]}`}>{entry.source}</span>
                <span class="feed-date">{entry.date}</span>
                <span class="feed-chevron" aria-hidden="true"></span>
              </summary>
              <p class="feed-detail">{entry.content}</p>
            </details>
          ))}
        </div>
      </section>

      <details class="panel calendar-settings" id="settings">
        <summary>Settings &amp; sync</summary>
        {lastUpdated && <p class="top-sync">Dashboard snapshot {lastUpdated}</p>}
        <div class="settings-grid">
          <div class="settings-section">
            <h3>Google Calendar</h3>
            <form id="calendar-form">
              <label>Google OAuth web client ID <input name="client" autocomplete="off" placeholder="…apps.googleusercontent.com" /></label>
              <label>Calendar IDs <input name="ids" value="primary" /></label>
              <button type="submit">Save settings</button>
              <button type="button" id="calendar-connect">Connect Google Calendar</button>
              <button type="button" id="calendar-disconnect" hidden>Disconnect</button>
            </form>
            <p class="top-sync" id="calendar-status" role="status"></p>
          </div>
          <div class="settings-section">
            <h3>Sync status</h3>
            <div class="sync-status-grid">
              <div class="sync-row"><span>Workstation</span><strong data-status="shared"></strong><button class="action-button" type="button" id="refresh-shared">Sync</button></div>
              <div class="sync-row"><span>Todoist</span><strong data-status="todoist"></strong><button class="action-button" type="button" id="refresh-todoist">Refresh</button></div>
              <div class="sync-row"><span>Calendar</span><strong data-status="calendar"></strong></div>
            </div>
          </div>
          <div class="settings-section">
            <h3>Import snapshot</h3>
            <label class="snapshot-picker">Workstation JSON <input id="snapshot-file" type="file" accept=".json,application/json" /></label>
            <button type="button" class="action-button" id="snapshot-import">Import records</button>
            <p role="status" class="top-sync" id="snapshot-feedback"></p>
          </div>
        </div>
      </details>
  </div>
</Base>

<script>
  import '../lib/blue-dashboard.mjs';
</script>
<script>
  import { importSnapshot } from '../lib/import-snapshot.mjs';
  import { syncInfo, refreshShared, refreshTodoist } from '../lib/shared.mjs';
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('blue-dashboard');
    if (!root) return;
    const controller = new AbortController();
    function renderSync() {
      const state = syncInfo();
      for (const key of ['shared','todoist','calendar']) {
        const el = root.querySelector('[data-status="' + key + '"]');
        if (!el) continue;
        const status = state[key].status;
        el.textContent = status;
        el.setAttribute('data-sync-state', /^Synced/.test(status) ? 'ready'
          : /^(Stale|Offline|Changes queued|Connecting|Checking|Refreshing)/.test(status) ? 'pending' : 'idle');
      }
    }
    document.getElementById('snapshot-import')?.addEventListener('click', async () => {
      const picker = /** @type {HTMLInputElement|null} */ (document.getElementById('snapshot-file'));
      const file = picker?.files?.[0];
      const feedback = document.getElementById('snapshot-feedback');
      if (!file || file.size > 1000000) { if (feedback) feedback.textContent = 'Choose a JSON file under 1 MB.'; return; }
      try {
        if (feedback) feedback.textContent = importSnapshot(JSON.parse(await file.text()));
        if (picker) picker.value = '';
      } catch (error) {
        if (feedback) feedback.textContent = error instanceof Error ? error.message : 'Import failed.';
      }
    });
    document.getElementById('refresh-shared')?.addEventListener('click', () => { void refreshShared(); });
    document.getElementById('refresh-todoist')?.addEventListener('click', () => { void refreshTodoist(); });
    document.addEventListener('workstation:sync', renderSync, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    renderSync();
  });
</script>
