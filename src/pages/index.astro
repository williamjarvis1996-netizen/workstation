---
import Base from '../layouts/Base.astro';
import { dashboard, isDemo } from '../content/dashboard';
const { tasks, log, quickLinks, calendarEvents, lastUpdated } = dashboard;
const recentLog = log.slice(0, 8);
const base = import.meta.env.BASE_URL;
const clientId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_CLIENT_ID || '';

const sourceColors: Record<string, string> = {
  slack: '#e01e5a',
  email: '#38bdf8',
  todoist: '#f87171',
  obsidian: '#a78bfa',
  manual: '#64748b',
};

---

<Base title="Workstation" active="overview">
  <div class="dashboard" id="blue-dashboard" data-client-id={clientId} data-demo={isDemo ? "true" : "false"}
    data-tasks={JSON.stringify(tasks)} data-calendar={JSON.stringify(calendarEvents)}>

    <!-- ===== HERO BAR ===== -->
    <section class="hero-bar">
      <div class="hero-left">
        <div class="hero-greeting" id="hero-greeting"></div>
        <div class="overview-heading">
          <h1 id="day-name-full"></h1>
          <div class="top-date">
            <span id="day-number" class="top-day-num"></span>
            <span id="day-month"></span>
          </div>
          {isDemo && <span class="top-sync">Sample data</span>}
        </div>
      </div>
      <div class="hero-center">
        <div class="analog-clock" id="analog-clock">
          <svg viewBox="0 0 200 200" class="clock-face">
            <circle cx="100" cy="100" r="95" class="clock-ring" />
            <circle cx="100" cy="100" r="88" class="clock-inner" />
            {[...Array(12)].map((_, i) => {
              const angle = (i * 30 - 90) * (Math.PI / 180);
              const x1 = 100 + 78 * Math.cos(angle);
              const y1 = 100 + 78 * Math.sin(angle);
              const x2 = 100 + 88 * Math.cos(angle);
              const y2 = 100 + 88 * Math.sin(angle);
              return <line x1={x1} y1={y1} x2={x2} y2={y2} class={`clock-tick ${i % 3 === 0 ? 'clock-tick--major' : ''}`} />;
            })}
            {[...Array(60)].map((_, i) => {
              if (i % 5 === 0) return null;
              const angle = (i * 6 - 90) * (Math.PI / 180);
              const x1 = 100 + 84 * Math.cos(angle);
              const y1 = 100 + 84 * Math.sin(angle);
              const x2 = 100 + 88 * Math.cos(angle);
              const y2 = 100 + 88 * Math.sin(angle);
              return <line x1={x1} y1={y1} x2={x2} y2={y2} class="clock-tick clock-tick--minor" />;
            })}
            <line id="clock-hour" x1="100" y1="100" x2="100" y2="48" class="clock-hand clock-hand--hour" />
            <line id="clock-minute" x1="100" y1="100" x2="100" y2="30" class="clock-hand clock-hand--minute" />
            <line id="clock-second" x1="100" y1="105" x2="100" y2="26" class="clock-hand clock-hand--second" />
            <circle cx="100" cy="100" r="4" class="clock-center" />
          </svg>
        </div>
        <div class="overview-clock">
          <time id="overview-clock"></time>
          <span class="top-sync clock-label">
            <svg width="10" height="13" viewBox="0 0 10 13" fill="none" style="vertical-align: -2px; margin-right: 3px;">
              <path d="M5 0C2.24 0 0 2.24 0 5c0 3.75 5 8 5 8s5-4.25 5-8c0-2.76-2.24-5-5-5zm0 6.8A1.8 1.8 0 1 1 5 3.2a1.8 1.8 0 0 1 0 3.6z" fill="currentColor" opacity="0.6"/>
            </svg>
            London, UK
          </span>
        </div>
      </div>
      <div class="hero-right">
        <div class="weather-card">
          <div class="weather-icon-row">
            <span class="weather-emoji" id="weather-icon"></span>
            <div class="weather-temp">
              <span class="weather-degrees" id="weather-temp"></span>
              <span class="weather-condition" id="weather-condition">Loading...</span>
            </div>
          </div>
          <span class="top-sync" id="weather-forecast"></span>
          {lastUpdated && <span class="top-sync">Snapshot {lastUpdated}</span>}
        </div>
      </div>
    </section>

    <section class="daily-summary" aria-label="Day at a glance">
      <div class="day-stat"><span>Next meeting</span><strong id="next-meeting">Calendar disconnected</strong></div>
      <div class="day-stat"><span>Due today</span><strong id="due-today">0 tasks</strong></div>
      <div class="day-stat"><span>Best focus window</span><strong id="focus-window">Calendar disconnected</strong></div>
    </section>

    <!-- ===== QUICK LINKS BAR ===== -->
    <nav class="links-bar">
      {quickLinks.map(link => (
        <a href={link.url} target="_blank" rel="noopener" class="qlink">
          {link.label}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 9L9 3M9 3H4M9 3v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      ))}
    </nav>

    <aside class="day-brief" aria-label="Current priority"><span id="day-brief-label">Your day</span><strong id="day-brief-text"></strong><a href={base + "plan/"}>Plan my day &rarr;</a></aside>
    <div class="day-grid">
      <section class="panel panel--today">
        <div class="panel-head">
          <h2>Today</h2>
          <span class="top-sync" id="calendar-connection">Calendar disconnected</span>
        </div>
        <div class="timeline" id="today-timeline"></div>
      </section>
      <section class="panel compact-tasks" id="tasks">
        <div class="panel-head"><h2>To-dos</h2><a class="panel-link" href={base + 'tasks/'}>All tasks &rarr;</a></div>
        <div class="task-tabs" aria-label="Filter preview">
          {['Priority', 'Today', 'Upcoming', 'Overdue'].map((label, i) => <button type="button" data-filter={label} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
        </div>
        <div id="today-tasks"></div>
        <p role="status" class="top-sync" id="task-feedback"></p>
      </section>
    </div>

      <section class="panel">
        <div class="panel-head">
          <h2>Activity</h2>
          <a href={`${base}log/`} class="panel-link">Full log &rarr;</a>
        </div>
        <div class="feed-grid">
          {recentLog.map(entry => (
            <details class="feed-item">
              <summary>
                <span class="feed-dot" style={`background: ${sourceColors[entry.source]}`}></span>
                <span class="feed-title">{entry.title}</span>
                <span class="feed-source" style={`background: ${sourceColors[entry.source]}22; color: ${sourceColors[entry.source]}`}>{entry.source}</span>
                <span class="feed-date">{entry.date}</span>
                <span class="feed-chevron" aria-hidden="true"></span>
              </summary>
              <p class="feed-detail">{entry.content}</p>
            </details>
          ))}
        </div>
      </section>

      <details class="calendar-settings" id="settings">
        <summary>Settings</summary>
        <form id="calendar-form">
          <label>Google OAuth web client ID <input name="client" autocomplete="off" placeholder="…apps.googleusercontent.com" /></label>
          <label>Calendar IDs <input name="ids" value="primary" /></label>
          <button type="submit">Save settings</button>
          <button type="button" id="calendar-connect">Connect Google Calendar</button>
          <button type="button" id="calendar-disconnect" hidden>Disconnect</button>
        </form>
        <p class="top-sync" id="calendar-status" role="status"></p>
      </details>
  </div>
</Base>

<script>
  import '../lib/blue-dashboard.mjs';
</script>
