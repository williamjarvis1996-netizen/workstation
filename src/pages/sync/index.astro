---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Sync | Workstation" active="sync">
  <div class="dashboard" id="sync-page">
    <header class="area-header"><h1>Sync</h1></header>
    <div class="daily-summary sync-cards">
      <section class="day-stat"><h2>Workstation</h2><strong data-status="shared"></strong><small data-synced="shared"></small>
        <p>Tasks, workouts, ideas, goals, handovers and day plans.</p><button class="action-button" type="button" id="refresh-shared">Sync now</button>
      </section>
      <section class="day-stat"><h2>Todoist</h2><strong data-status="todoist"></strong><small data-synced="todoist"></small>
        <p>Open tasks and completion back to Todoist when connected.</p><button class="action-button" type="button" id="refresh-todoist">Refresh tasks</button>
      </section>
      <section class="day-stat"><h2>Google Calendar</h2><strong data-status="calendar"></strong><small data-synced="calendar"></small>
        <p>Read-only access for the agenda and planner.</p><a href={base + '#settings'}>Calendar settings</a>
      </section>
    </div>
    <section class="panel">
      <h2>Import a private snapshot</h2>
      <p>Import projects, tasks and workouts from a Workstation JSON export. Existing captures are preserved.</p>
      <label class="snapshot-picker">Workstation JSON <input id="snapshot-file" type="file" accept=".json,application/json" /></label>
      <button type="button" class="action-button" id="snapshot-import">Import records</button>
      <p role="status" class="top-sync" id="snapshot-feedback"></p>
    </section>
  </div>
</Base>
<script>
  import { importSnapshot } from '../../lib/import-snapshot.mjs';
  import { syncInfo, refreshShared, refreshTodoist } from '../../lib/shared.mjs';
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('sync-page');
    if (!root) return;
    const controller = new AbortController();
    const format = new Intl.DateTimeFormat('en-GB', {dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/London'});
    function render() {
      const state = syncInfo();
      for (const key of ['shared','todoist','calendar']) {
        const source = state[key];
        root!.querySelector(`[data-status="${key}"]`)!.textContent = source.status;
        root!.querySelector(`[data-synced="${key}"]`)!.textContent = source.syncedAt ? 'Last sync ' + format.format(new Date(source.syncedAt)) + ' London' : 'No sync recorded';
      }
      (document.getElementById('refresh-shared') as HTMLButtonElement).disabled = state.shared.status === 'Browser only';
      (document.getElementById('refresh-todoist') as HTMLButtonElement).disabled = state.todoist.status === 'Unavailable on this build';
    }
    root.querySelector('#snapshot-import')!.addEventListener('click', async () => {
      const picker = root.querySelector<HTMLInputElement>('#snapshot-file')!;
      const file = picker.files?.[0];
      const feedback = root.querySelector('#snapshot-feedback')!;
      if (!file || file.size > 1000000) { feedback.textContent = 'Choose a JSON file under 1 MB.'; return; }
      try {
        feedback.textContent = importSnapshot(JSON.parse(await file.text()));
        picker.value = '';
      } catch (error) {
        feedback.textContent = error instanceof Error ? error.message : 'Import failed.';
      }
    });
    root.querySelector('#refresh-shared')!.addEventListener('click', () => { void refreshShared(); });
    root.querySelector('#refresh-todoist')!.addEventListener('click', () => { void refreshTodoist(); });
    document.addEventListener('workstation:sync', render, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    render();
  });
</script>
