---
import Base from '../../layouts/Base.astro';
import WorkNav from '../../components/WorkNav.astro';
import { dashboard, isDemo } from '../../content/dashboard';

const projects = dashboard.projects.map(({ code, name, status, nextMilestone, nextMilestoneDate, deadline }) =>
  ({ code, name, status, nextMilestone, nextMilestoneDate, deadline }));
const projectRoot = import.meta.env.BASE_URL + 'work/';
---
<Base title="Timeline | Work" active="work">
  <div class="dashboard">
    <header class="area-header"><h1>Timeline</h1></header>
    <WorkNav active="timeline" />

    <section class="panel production-timeline" id="production-timeline" data-projects={JSON.stringify(projects)} data-demo={String(isDemo)} data-project-root={projectRoot}>
      <div class="panel-head">
        <div>
          <h2>Next 14 days</h2>
          <p class="top-sync" id="timeline-range"></p>
        </div>
        <p class="timeline-clash-summary" id="timeline-clashes"></p>
      </div>
      <div id="timeline-weeks"></div>
      <div id="timeline-other-dates"></div>
      <noscript><p>Enable JavaScript to show the current London-date timeline.</p></noscript>
    </section>
  </div>
</Base>

<script>
  import { make } from '../../lib/storage.mjs';
  import { londonDay } from '../../lib/time.mjs';
  import { portfolioProjects, readLife } from '../../lib/life.mjs';
  import { productionDates, timelineWindow } from '../../lib/work-timeline.mjs';

  const shortDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const weekday = new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'UTC' });
  const format = (formatter: Intl.DateTimeFormat, date: string) => formatter.format(new Date(date + 'T00:00:00Z'));

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('production-timeline');
    if (!root) return;
    const range = document.getElementById('timeline-range')!;
    const clashes = document.getElementById('timeline-clashes')!;
    const weeks = document.getElementById('timeline-weeks')!;
    const otherDates = document.getElementById('timeline-other-dates')!;
    const snapshot = JSON.parse(root.dataset.projects!);
    const snapshotCodes = new Set(snapshot.map(project => project.code));
    const demo = root.dataset.demo === 'true';
    let lastRender = '';

    function projectList(items, showDate = false) {
      const list = make('ul', '', 'timeline-projects');
      for (const item of items) {
        const row = make('li', '', 'timeline-project-date');
        const link = make('a', item.project);
        link.href = root!.dataset.projectRoot + (snapshotCodes.has(item.code)
          ? encodeURIComponent(item.code.toLowerCase()) + '/'
          : '#project-' + encodeURIComponent(item.code));
        const label = make('span', item.label, item.kind === 'deadline' ? 'timeline-deadline' : 'timeline-milestone');
        if (showDate) {
          const time = make('time', format(shortDate, item.date));
          time.dateTime = item.date;
          row.append(time);
        }
        row.append(link, label);
        list.append(row);
      }
      return list;
    }

    function refresh() {
      const today = londonDay(Date.now());
      const dates = productionDates(portfolioProjects(snapshot, demo), readLife().projectPlans);
      const signature = JSON.stringify([today, dates]);
      if (signature === lastRender) return;
      lastRender = signature;
      const { days, clashes: count, earlier, later } = timelineWindow(dates, today);
      range.textContent = `${format(shortDate, today)} – ${format(shortDate, days[13].date)} · London`;
      clashes.textContent = count ? `${count} ${count === 1 ? 'day' : 'days'} with overlapping projects` : 'No overlapping project dates';
      clashes.classList.toggle('has-clash', count > 0);
      weeks.replaceChildren();
      if (!days.some(day => day.items.length)) {
        weeks.append(make('p', 'No dated production milestones or deadlines in this window.', 'empty-state-sm'));
      } else {
        for (const slice of [days.slice(0, 7), days.slice(7)]) {
          const week = make('div', '', 'timeline-week');
          for (const day of slice) {
            const cell = make('section', '', 'timeline-date-cell');
            cell.classList.toggle('is-empty', !day.items.length);
            cell.classList.toggle('is-today', day.date === today);
            cell.classList.toggle('has-clash', day.projectCount > 1);
            const title = make('h3');
            const date = make('time', `${format(weekday, day.date)} ${format(shortDate, day.date)}`);
            date.dateTime = day.date;
            title.append(date);
            cell.append(title);
            if (day.projectCount > 1) cell.append(make('p', `${day.projectCount} projects`, 'timeline-day-clash'));
            if (day.items.length) cell.append(projectList(day.items));
            week.append(cell);
          }
          weeks.append(week);
        }
      }
      otherDates.replaceChildren();
      for (const [label, entries] of [['Earlier project dates', earlier], ['Later project dates', later]]) {
        if (!entries.length) continue;
        const details = make('details');
        details.append(make('summary', `${label} (${entries.length})`), projectList(entries, true));
        otherDates.append(details);
      }
    }

    const controller = new AbortController();
    refresh();
    const timer = window.setInterval(refresh, 60000);
    for (const event of ['visibilitychange', 'workstation:change', 'workstation:sync']) {
      document.addEventListener(event, refresh, { signal: controller.signal });
    }
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      window.clearInterval(timer);
    }, { once: true });
  });
</script>

<style is:global>
  .production-timeline #timeline-weeks { display: grid; gap: var(--space-sm); }
  .production-timeline .timeline-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--space-xs); }
  .production-timeline .timeline-date-cell { min-width: 0; min-height: 5rem; padding: .55rem; border: 1px solid var(--color-border-hover); border-radius: var(--radius); background: var(--color-surface); }
  .production-timeline .timeline-date-cell h3 { font: 700 .72rem/1.4 var(--font-mono); color: var(--color-fg-muted); }
  .production-timeline .timeline-date-cell.is-today { border-color: var(--area-accent); }
  .production-timeline .timeline-date-cell.is-today h3 { color: var(--area-accent); }
  .production-timeline .timeline-date-cell.has-clash { background: var(--area-tint); border-color: var(--area-border); }
  .production-timeline .timeline-clash-summary, .production-timeline .timeline-day-clash { color: var(--color-fg-muted); font: .72rem/1.5 var(--font-mono); }
  .production-timeline .timeline-clash-summary.has-clash, .production-timeline .timeline-day-clash { color: var(--area-accent); }
  .production-timeline .timeline-projects { list-style: none; display: grid; gap: .55rem; margin-top: .5rem; margin-inline-start: .23rem; border-inline-start: 1px solid var(--area-border); }
  .production-timeline .timeline-project-date { display: grid; gap: .15rem; position: relative; padding-inline-start: .65rem; font-size: .79rem; overflow-wrap: anywhere; line-height: 1.4; }
  .production-timeline .timeline-project-date::before { content: ""; position: absolute; inset: .4em auto auto -.24rem; width: .42rem; aspect-ratio: 1; border-radius: 50%; background: var(--area-accent); }
  .production-timeline .timeline-project-date a { color: var(--color-fg); font-weight: 650; }
  .production-timeline .timeline-project-date a:hover { color: var(--area-accent); text-decoration: underline; }
  .production-timeline .timeline-milestone, .production-timeline .timeline-project-date time { color: var(--color-fg-muted); }
  .production-timeline .timeline-deadline { color: var(--color-warn); }
  .production-timeline #timeline-other-dates details { margin-top: var(--space-md); border-top: 1px solid var(--color-border); padding-top: var(--space-sm); }
  .production-timeline #timeline-other-dates summary { color: var(--color-fg-muted); cursor: pointer; }
  @media (max-width: 960px) {
    .production-timeline .timeline-week { display: contents; }
    .production-timeline .timeline-date-cell { min-height: 0; padding: .7rem; }
    .production-timeline .timeline-date-cell.is-empty { display: none; }
  }
</style>
