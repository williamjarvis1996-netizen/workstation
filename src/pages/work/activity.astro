---
import Base from '../../layouts/Base.astro';
import WorkNav from '../../components/WorkNav.astro';
import { dashboard } from '../../content/dashboard';

const log = dashboard.log;

const sourceColors: Record<string, string> = {
  slack: '#e01e5a',
  email: '#38bdf8',
  todoist: '#f87171',
  obsidian: '#a78bfa',
  manual: '#64748b',
};

const grouped = new Map<string, typeof log>();
for (const entry of log) {
  const list = grouped.get(entry.date) || [];
  list.push(entry);
  grouped.set(entry.date, list);
}
---
<Base title="Activity | Work" active="work">
  <div class="dashboard">
    <header class="area-header"><h1>Activity</h1></header>
    <WorkNav active="activity" />

    <div class="activity-view">
      {[...grouped.entries()].map(([date, entries]) => (
        <section class="activity-day">
          <h2 class="activity-date">{new Date(date + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</h2>
          <div class="activity-entries">
            {entries.map(entry => (
              <details class="feed-item">
                <summary>
                  <span class="feed-dot" style={`background: ${sourceColors[entry.source]}`}></span>
                  <span class="feed-title">{entry.title}</span>
                  <span class="feed-source" style={`background: ${sourceColors[entry.source]}22; color: ${sourceColors[entry.source]}`}>{entry.source}</span>
                  <span class="feed-chevron" aria-hidden="true"></span>
                </summary>
                <p class="feed-detail">{entry.content}</p>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .activity-view { display: grid; gap: var(--section-gap); }
  .activity-day { display: grid; gap: var(--space-sm); min-width: 0; padding: var(--panel-inset); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .activity-date { font: 650 1rem/1.3 var(--font-sans); color: var(--color-fg); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-border); }
  .activity-entries { display: grid; gap: .25rem; }
</style>
