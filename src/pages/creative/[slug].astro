---
import Base from '../../layouts/Base.astro';
import { dashboard } from '../../content/dashboard';

export function getStaticPaths() {
  return dashboard.creativeProjects.map((project, index) => ({
    params: { slug: project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-+$/, '') },
    props: { project, index },
  }));
}

const { project, index } = Astro.props;
const actionKey = JSON.stringify([project.name, project.type, index]);
const base = import.meta.env.BASE_URL;

const statusColor: Record<string, string> = {
  'Post-production': 'var(--color-accent)',
  'Development': 'var(--color-warn)',
  'Optioned': 'var(--color-success)',
  'Festival circulation': '#a78bfa',
};
---
<Base title={`${project.name} | Creative`} active="creative">
  <div class="dashboard project-detail">
    <nav class="project-breadcrumb">
      <a href={base + 'creative/'}>Creative slate</a>
      <span>/</span>
      <span>{project.name}</span>
    </nav>

    <header class="project-hero" style={`--health-color: ${statusColor[project.status] || 'var(--color-accent)'}`}>
      <div class="project-hero-top">
        <span class="pcard-health" style={`background: ${statusColor[project.status] || 'var(--color-accent)'}22; color: ${statusColor[project.status] || 'var(--color-accent)'}`}>{project.status}</span>
        <span class="project-priority">{project.type}</span>
      </div>
      <h1>{project.name}</h1>
    </header>

    <div class="project-grid">
      <section class="panel project-section">
        <h2>Next action</h2>
        <form class="slate-action creative-project-action" data-action-key={actionKey}>
          <label>What moves this project forward?
            <input name="action" value={project.nextAction || ''} maxlength="180" />
          </label>
          <button type="submit">Save</button>
        </form>
        <p class="top-sync" id="creative-action-feedback" role="status"></p>
      </section>
      <section class="panel project-section">
        <h2>Project summary</h2>
        <p>{project.summary}</p>
      </section>
    </div>
  </div>
</Base>
<script>
  import { readLife, updateLife } from '../../lib/life.mjs';

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('.creative-project-action');
    const feedback = document.getElementById('creative-action-feedback');
    if (!form || !feedback) return;
    const key = form.dataset.actionKey!;
    const input = form.elements.namedItem('action') as HTMLInputElement;
    const saved = readLife().creativeActions;
    if (Object.hasOwn(saved, key)) input.value = saved[key];
    form.addEventListener('submit', event => {
      event.preventDefault();
      const action = input.value.trim();
      try {
        updateLife(data => { data.creativeActions[key] = action; });
        input.value = action;
        feedback.textContent = action ? 'Next action saved.' : 'Next action cleared.';
      } catch {
        feedback.textContent = 'Could not save the next action.';
      }
    });
  });
</script>
