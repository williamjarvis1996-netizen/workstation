---
import Base from '../../layouts/Base.astro';
import { dashboard, isDemo } from '../../content/dashboard';
const { personalGoals } = dashboard;
---
<Base title="Goals | Workstation" active="goals">
  <div class="dashboard">
    <header class="area-header"><h1>Goals</h1>{isDemo && <span class="top-sync">Sample data</span>}</header>
        <div class="personal-card personal-card--goals">
          <div class="pc-head">
            <h3>Goals</h3>
          </div>
          <div class="goals-list">
            {personalGoals.map(goal => (
              <div class="goal-item">
                <div class="goal-top">
                  <span class="goal-name">{goal.name}</span>
                  <span class="goal-cat">{goal.category}</span>
                </div>
                <div class="goal-detail">{goal.detail}</div>
              </div>
            ))}
          </div>
        </div>


  </div>
</Base>
