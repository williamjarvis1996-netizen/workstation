---
import Base from '../../layouts/Base.astro';
---
<Base title="Links | Workstation" active="links">
  <header class="hero"><div><h1>Links</h1></div></header>
  <div id="links-grid" class="workspace-grid"></div>
</Base>
<script>
  import { load, make, externalLink } from '../../lib/storage.mjs';
  const links = load().quickLinks;
  const list = document.querySelector('#links-grid')!;
  const defaults = [
    { label: 'Google Calendar', url: 'https://calendar.google.com/', category: 'Planning' },
    { label: 'Todoist', url: 'https://app.todoist.com/', category: 'Planning' },
    { label: 'Gmail', url: 'https://mail.google.com/', category: 'Communication' },
    { label: 'Slack', url: 'https://app.slack.com/', category: 'Communication' },
  ];
  const entries = links.length ? links : defaults;
  for (const category of new Set(entries.map(link => link.category))) {
    const section = make('section', '', 'panel');
    section.append(make('h2', category));
    for (const link of entries.filter(item => item.category === category)) {
      const a = externalLink(link.label, link.url);
      a.className = 'link-row';
      section.append(a);
    }
    list.append(section);
  }
</script>
