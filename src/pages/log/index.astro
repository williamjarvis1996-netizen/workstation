---
import Base from '../../layouts/Base.astro';
import { log } from '../../content/dashboard';
---

<Base title="Log | Workstation">
  <div class="log-page">
    <div class="page-header">
      <p class="section-label">Activity log</p>
      <h1>Log</h1>
      <p class="page-subtitle">{log.length} entries across all sources</p>
    </div>

    <ul class="log-list">
      {log.map((entry, i) => {
        const showDateDivider = i === 0 || log[i - 1].date !== entry.date;
        return (
          <>
            {showDateDivider && (
              <li class="date-divider">
                <span class="date-divider-text">{entry.date}</span>
                <span class="date-divider-line"></span>
              </li>
            )}
            <li class="log-item">
              <div class="log-left">
                <span class={`log-dot log-dot--${entry.source}`}></span>
                <span class="log-line"></span>
              </div>
              <div class="log-body">
                <div class="log-meta">
                  <span class={`log-source log-source--${entry.source}`}>{entry.source}</span>
                </div>
                <p class="log-title">{entry.title}</p>
                <p class="log-content">{entry.content}</p>
              </div>
            </li>
          </>
        );
      })}
    </ul>
  </div>
</Base>

<style>
  .log-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.03em;
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-fg-subtle);
  }

  .log-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .date-divider {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) 0 var(--space-sm);
  }

  .date-divider:first-child {
    padding-top: 0;
  }

  .date-divider-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .date-divider-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .log-item {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-md) 0;
  }

  .log-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2px;
    flex-shrink: 0;
    width: 12px;
  }

  .log-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-fg-subtle);
  }

  .log-dot--slack { background: #e01e5a; }
  .log-dot--email { background: var(--color-accent); }
  .log-dot--todoist { background: var(--color-danger); }
  .log-dot--obsidian { background: var(--color-purple); }
  .log-dot--manual { background: var(--color-fg-subtle); }

  .log-line {
    flex: 1;
    width: 1px;
    background: var(--color-border);
    margin-top: var(--space-xs);
  }

  .log-body {
    flex: 1;
    min-width: 0;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .log-item:last-child .log-body {
    border-bottom: none;
  }

  .log-item:last-child .log-line {
    display: none;
  }

  .log-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-2xs);
  }

  .log-source {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15em 0.45em;
    border-radius: 3px;
    background: var(--color-surface-raised);
    color: var(--color-fg-muted);
  }

  .log-source--slack { color: #e01e5a; background: rgba(224, 30, 90, 0.1); }
  .log-source--email { color: var(--color-accent); background: var(--color-accent-dim); }
  .log-source--todoist { color: var(--color-danger); background: rgba(248, 113, 113, 0.08); }
  .log-source--obsidian { color: var(--color-purple); background: rgba(167, 139, 250, 0.1); }
  .log-source--manual { color: var(--color-fg-muted); }

  .log-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .log-content {
    font-size: 0.8rem;
    color: var(--color-fg-muted);
    line-height: 1.6;
    margin-top: var(--space-2xs);
  }
</style>
