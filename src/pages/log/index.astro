---
import Base from '../../layouts/Base.astro';
---
<Base title="Activity | Workstation" active="log">
  <header class="hero"><div><h1>Activity</h1></div></header>
  <section class="panel" aria-label="Activity log">
    <div class="form-row page-controls">
      <label>Search <input type="search" id="log-search" placeholder="Search activity" /></label>
      <label>Source <select id="log-source"><option value="">All sources</option></select></label>
    </div>
    <p id="log-count" class="muted status" role="status"></p>
    <div id="log-list"></div>
  </section>
</Base>

<script>
  import { load, make } from '../../lib/storage.mjs';
  import { activityEntry } from '../../lib/rows.mjs';
  const search = document.querySelector<HTMLInputElement>('#log-search')!;
  const source = document.querySelector<HTMLSelectElement>('#log-source')!;
  const list = document.querySelector('#log-list')!;
  const count = document.querySelector('#log-count')!;
  const { log } = load();
  for (const name of [...new Set(log.map(entry => entry.source))].sort()) {
    source.add(new Option(name, name));
  }
  function render() {
    const query = search.value.trim().toLowerCase();
    const matches = log.filter(entry => (!source.value || entry.source === source.value)
      && (entry.title + ' ' + entry.content).toLowerCase().includes(query));
    list.replaceChildren(...matches.map(activityEntry));
    count.textContent = `${matches.length} ${matches.length === 1 ? 'entry' : 'entries'}`;
    if (!matches.length) list.append(make('p', log.length ? 'No matching activity.' : 'Import a snapshot from Settings to see activity here.', 'empty'));
  }
  search.addEventListener('input', render);
  source.addEventListener('change', render);
  render();
</script>
